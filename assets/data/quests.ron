[
    // The tutorial: Officer Pruitt stands next to where new characters arrive.
    (
        id: "welcome",
        name: "Welcome to the City",
        stages: [
            (
                log: "Officer Pruitt wants a Fizz Cola from Mr. Kim's Corner Store, across Maple Street.",
                advance_when: [HasItem("soda", 1)],
                hint: Some("Mr. Kim stands outside the Corner Store, across Maple Street. Click the ground to walk there (or use {MoveForward}{MoveLeft}{MoveBack}{MoveRight}), press {Interact} to talk, choose to shop, then click Buy next to Fizz Cola. {Map} shows the map."),
            ),
            (
                log: "Bring the Fizz Cola to Officer Pruitt, outside the Byte Cafe.",
                hint: Some("Walk back to Officer Pruitt and press {Interact}. Your bag is on {Inventory}: rest the mouse on anything to see what it does."),
            ),
        ],
        rewards: (cash: 10, items: [("first_aid_kit", 1)], rep: [("city", 25)]),
    ),
    (
        id: "56k_dreams",
        name: "56k Dreams",
        stages: [
            (log: "Dot at the Byte Cafe needs a replacement modem. Ask Sal at Pawn & Pager."),
            (
                log: "Fix the fried modem: use it from your inventory. You'll need a Screwdriver Set (Corner Store, across the street).",
                advance_when: [HasItem("working_modem", 1)],
                hint: Some("Press {Inventory}, click the modem, then Use. Stand still until the repair finishes: moving cancels it."),
            ),
            (log: "Bring the repaired modem back to Dot at the Byte Cafe."),
        ],
        rewards: (cash: 40, xp: [(Electronics, 150)], items: [("pager", 1)]),
    ),
    (
        id: "rat_problem",
        name: "Rat Problem",
        stages: [
            (
                log: "Foreman Rizzo wants you to knock out 5 Dock Rats around the containers at Harbor Docks.",
                advance_when: [Kills("dock_rat", 5)],
                hint: Some("{Target} targets the nearest Dock Rat (press again for the next one), {Attack} starts or stops fighting, {PowerSwing} swings hard. Low on health? Use a First Aid Kit."),
            ),
            (log: "Tell Foreman Rizzo, by the Metro exit, that the Dock Rats got the message."),
        ],
        rewards: (cash: 30, xp: [(Fitness, 120)], items: [("first_aid_kit", 2)], rep: [("dockside", 120)]),
    ),
    (
        id: "mall_rats",
        name: "Mall Rats",
        stages: [
            (log: "Joey at Pixel Palace (Galleria Mall) wants 3 Burned CDs for his mixtape.", advance_when: [HasItem("burned_cd", 3)]),
            (log: "Bring the 3 Burned CDs to Joey at Pixel Palace."),
        ],
        rewards: (cash: 25, xp: [(Electronics, 80)], items: [("mixtape", 1)], rep: [("city", 80)]),
    ),
    (
        id: "scrap_run",
        name: "Scrap Run",
        stages: [
            (log: "Old Earl at the Abandoned Factory gate needs 6 Scrap Metal. Scrappers and Copper Thieves carry it.", advance_when: [HasItem("scrap_metal", 6)]),
            (log: "Bring the 6 Scrap Metal to Old Earl by the factory gate."),
        ],
        rewards: (cash: 40, xp: [(Mechanics, 150)], items: [("wrench", 1)]),
    ),
    (
        id: "junker",
        name: "Earl's Junker",
        stages: [
            (
                log: "Old Earl will let you have his old hatchback if you can get it running: bring a Carburetor (rebuild a rusty one with your wrench), a Car Battery and 2 Spark Plugs, and reach Mechanics level 3.",
                advance_when: [HasItem("carburetor", 1), HasItem("car_battery", 1), HasItem("spark_plug", 2), SkillLevel(Mechanics, 3)],
            ),
            (log: "You have everything. Bring the parts to Old Earl at the factory gate."),
        ],
        rewards: (cash: 0, xp: [(Mechanics, 120)], items: []),
    ),
    (
        id: "y2k_compliance",
        name: "Y2K Compliance",
        stages: [
            (
                log: "Mr. Pemberton at Meridian Corp needs 2 Working Modems before the millennium bug eats the office. Broken ones can be repaired with a Screwdriver Set.",
                advance_when: [HasItem("working_modem", 2)],
            ),
            (log: "Bring the 2 Working Modems to Mr. Pemberton outside the Meridian Office Block."),
        ],
        rewards: (cash: 60, xp: [(Electronics, 100)], items: [], rep: [("meridian", 150)]),
    ),
    (
        id: "lunch_rush",
        name: "Lunch Rush",
        stages: [
            (
                log: "Flo at the Sunny Side Diner is short a cook. Make 3 Grilled Cheese: cheese and bread from Value Grocer, a frying pan, then use the cheese.",
                advance_when: [HasItem("grilled_cheese", 3)],
            ),
            (log: "Bring the 3 Grilled Cheese to Flo at the Sunny Side Diner."),
        ],
        rewards: (cash: 25, xp: [(Cooking, 120)], items: [("chef_hat", 1)], rep: [("city", 30)]),
    ),
    (
        id: "phreaking_101",
        name: "Phreaking 101",
        stages: [
            (
                log: "Glitch, behind the Byte Cafe, wants proof you're not a narc: hack the payphone on Maple & 5th (talk to it and choose Hack).",
                advance_when: [Hacked("payphone", 1)],
            ),
            (log: "Tell Glitch, behind the Byte Cafe, that the payphone is yours."),
        ],
        rewards: (cash: 15, xp: [(Hacking, 100)], items: [("acoustic_coupler", 1)], rep: [("zeros", 100)]),
    ),
    (
        id: "black_ice",
        name: "Black ICE",
        stages: [
            (
                log: "Glitch wants the shipping manifests from the Harbor Office terminal at the docks. It needs Hacking 6 (gear counts).",
                advance_when: [Hacked("harbor_office", 1)],
            ),
            (log: "Bring the manifests to Glitch behind the Byte Cafe."),
        ],
        rewards: (cash: 80, xp: [(Hacking, 200)], items: [("laptop", 1)], rep: [("zeros", 150), ("dockside", -30)]),
    ),
    (
        id: "rooftop_stash",
        name: "Rooftop Stash",
        stages: [(log: "You found someone's stash in a vent on the Riverside Apartments roof.")],
        rewards: (cash: 50, xp: [(Fitness, 60)], items: [("bootleg_cd", 1)]),
    ),
    (
        id: "parts_run",
        name: "Parts Run",
        stages: [
            (log: "Old Earl needs a timing belt from Hank's Garage in Pinecrest. Drive west out of town: the end of Maple St is the on-ramp to Route 9; Pinecrest is at the far end."),
            (log: "Bring the timing belt back to Old Earl at the factory gate."),
        ],
        rewards: (cash: 50, xp: [(Mechanics, 150), (Driving, 100)], items: []),
    ),
    (
        id: "scenic_route",
        name: "Scenic Route",
        stages: [
            (log: "Hank wants footage of the Scenic Lookout in Hollow Pines State Park (up the turnoff from Route 9). You'll need a working camcorder."),
            (log: "Take the footage back to Hank in Pinecrest."),
        ],
        rewards: (cash: 60, xp: [(Driving, 120), (Electronics, 60)], items: [("road_atlas", 1)]),
    ),
    (
        id: "leave_no_trace",
        name: "Leave No Trace",
        stages: [
            (log: "Ranger Dale wants the poachers out of Hollow Pines. Run off 3 of them.", advance_when: [Kills("poacher", 3)]),
            (log: "Tell Ranger Dale at the ranger station that the woods are clear."),
        ],
        rewards: (cash: 40, xp: [(Fitness, 150)], items: [("hiking_boots", 1)], rep: [("city", 100)]),
    ),
    (
        id: "neighborhood_watch",
        name: "Neighborhood Watch",
        stages: [
            (log: "Doug at Value Grocer is fed up with the pranksters out back. Run off 4 of them.", advance_when: [Kills("prankster", 4)]),
            (log: "Tell Doug at Value Grocer the pranksters are gone."),
        ],
        rewards: (cash: 30, xp: [(Fitness, 80)], items: [("footlocker", 1)], rep: [("city", 50)]),
    ),
    (
        id: "paper_route",
        name: "Paper Route",
        stages: [
            (log: "Kevin's bike has a flat. Deliver his papers: first to 3 Willow Court (the house at the end of the cul-de-sac, west side)."),
            (log: "Next paper: 4 Willow Court, across the cul-de-sac."),
            (log: "Last paper: 20 Oak Lane, south of Elm Street."),
            (log: "Tell Kevin his papers are delivered."),
        ],
        rewards: (cash: 25, xp: [(Fitness, 60)], items: [("skate_shoes", 1)], rep: [("city", 20)]),
    ),
    (
        id: "radio_free_maple",
        name: "Radio Free Maple",
        stages: [
            (log: "Skyler wants the pirate radio playing something good: hack the antenna junction box on the rooftops (Hacking 5).", advance_when: [Hacked("pirate_antenna", 1)]),
            (log: "Tell Skyler the station is back on the air."),
        ],
        rewards: (cash: 30, xp: [(Hacking, 120)], items: [("band_poster", 1)], rep: [("zeros", 60)]),
    ),
    (
        id: "running_on_empty",
        name: "Running on Empty",
        stages: [
            (log: "The coffee machine at the Gas-N-Go is broken and the truckers are getting cranky. Brew Rhonda 3 Thermoses of Coffee (Cooking 2: coffee beans and a frying pan, or your stove at home).", advance_when: [HasItem("diner_coffee", 3)]),
            (log: "Bring the 3 Thermoses of Coffee to Rhonda at the Gas-N-Go."),
        ],
        rewards: (cash: 30, xp: [(Cooking, 100)], items: [("trucker_cap", 1)], rep: [("city", 20)]),
    ),
    (
        id: "pinecrest_ghost",
        name: "The Pinecrest Ghost",
        stages: [
            (log: "Sheriff Ruth says there are lights in the Pinecrest church bell tower at night. Have a look after 8 PM."),
            (log: "You found a floppy disk in the bell tower, labelled GHOST.EXE. Show it to Sheriff Ruth."),
        ],
        rewards: (cash: 30, xp: [(Fitness, 60)], items: [], rep: [("city", 40)]),
    ),
    (
        id: "ghost_in_the_machine",
        name: "Ghost in the Machine",
        stages: [
            (log: "Sheriff Ruth can't read the GHOST.EXE floppy. Someone who knows computers might: Glitch, behind the Byte Cafe downtown."),
        ],
        rewards: (cash: 40, xp: [(Hacking, 150)], items: [], rep: [("zeros", 80)]),
    ),
    (
        id: "motel_mixup",
        name: "Motel Mix-up",
        stages: [
            (log: "Dolores at the Pine Motel dropped the room keys on a walk at the Hollow Pines lookout. Find them."),
            (log: "Bring the keys back to Dolores at the Pine Motel."),
        ],
        rewards: (cash: 40, xp: [(Fitness, 60), (Driving, 60)], items: []),
    ),
    (
        id: "trail_mix",
        name: "Trail Mix",
        stages: [
            (log: "Ranger Dale wants the litterbug campers out of Hollow Pines. Run off 3 of them.", advance_when: [Kills("litterbug", 3)]),
            (log: "Tell Ranger Dale the campsites are clean."),
        ],
        rewards: (cash: 30, xp: [(Fitness, 100)], items: [("bucket_hat", 1)], rep: [("city", 60)]),
    ),
    (
        id: "corporate_retreat",
        name: "Corporate Retreat",
        stages: [
            (log: "Mr. Pemberton needs a locked briefcase taken to the Pine Motel in Pinecrest, for the Meridian board's retreat. Give it to Dolores. Don't open it."),
            (log: "Tell Mr. Pemberton the briefcase arrived."),
        ],
        rewards: (cash: 80, xp: [(Driving, 150)], items: [], rep: [("meridian", 150)]),
    ),
    // --- Milestone 15: the road trip chain (Kat's zine, then Big Ray's load) and Lake Wren.
    (
        id: "road_trip",
        name: "Route 9 Revisited",
        stages: [
            (
                log: "Kat is making a zine about Route 9. First stop: a postcard from Rhonda at the Gas-N-Go.",
                advance_when: [HasItem("gas_n_go_postcard", 1)],
                hint: Some("Route 9 is the highway off the west end of Maple St: you'll need a car. Rhonda runs the Gas-N-Go."),
            ),
            (
                log: "Get one of Gus's carved loons at Bait & Tackle in Lake Wren (the south turnoff off Route 9).",
                advance_when: [HasItem("carved_loon", 1)],
                hint: Some("Gus trades loons for fish. Rods and worms are on his shelf; fish from the end of the pier: use the Nightcrawlers from {Inventory} at the Fishing Spot."),
            ),
            (
                log: "Get Mama Jo to sign a menu at the Mile 88 Truck Stop (drive on past Pinecrest).",
                advance_when: [HasItem("signed_menu", 1)],
                hint: Some("Mama Jo doesn't sign anything for people who haven't had the pie."),
            ),
            (log: "Bring the postcard, the loon and the signed menu to Kat outside Spin City Records, downtown."),
        ],
        rewards: (cash: 120, xp: [(Driving, 250)], items: [("denim_jacket", 1)], rep: [("city", 40)]),
    ),
    (
        id: "long_haul",
        name: "The Long Haul",
        stages: [
            (
                log: "Big Ray's rig at the Mile 88 Truck Stop needs a working Alternator. Fix a seized one (Mechanics 3, a wrench: Wanda at Diesel Bay sells both).",
                advance_when: [HasItem("alternator", 1)],
                hint: Some("Use the Seized Alternator from {Inventory} with a Wrench in your bag. Stand still till it's done."),
            ),
            (log: "Give the alternator to Wanda at Diesel Bay."),
            (log: "Take the crate of CB radios to Foreman Rizzo at the Harbor Docks."),
            (log: "Take Rizzo's signed receipt back to Big Ray at the Mile 88 Truck Stop."),
        ],
        rewards: (cash: 150, xp: [(Driving, 200), (Mechanics, 80)], items: [("cb_handset", 1)], rep: [("dockside", 40)]),
    ),
    (
        id: "gone_fishing",
        name: "Gone Fishing",
        stages: [
            (
                log: "Gus at Bait & Tackle in Lake Wren wants 3 Lake Perch for the Lodge's fish fry.",
                advance_when: [HasItem("lake_perch", 3)],
                hint: Some("Buy a Fishing Rod and Nightcrawlers from Gus, walk to the Fishing Spot at the end of the pier and use the Nightcrawlers from {Inventory}. Stand still while you fish."),
            ),
            (log: "Bring the 3 Lake Perch to Gus at Bait & Tackle."),
        ],
        rewards: (cash: 15, xp: [(Cooking, 120)], items: [("nightcrawlers", 10), ("minnows", 5)], rep: [("city", 15)]),
    ),
]
