// Dialogue trees. Options are shown only when all `when` conditions hold, and the server
// re-checks them when chosen. `effects` apply all-or-nothing. `goto: None` ends the conversation.
[
    (
        id: "dot",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to the Byte Cafe! ...Well, it's usually busier than this.",
                options: [
                    (text: "Why is it so quiet in here?", when: [QuestNotStarted("56k_dreams")], goto: Some("problem")),
                    (text: "Still looking for that modem.", when: [QuestAt("56k_dreams", 0)], goto: Some("reminder")),
                    (text: "I'm working on fixing the modem.", when: [QuestAt("56k_dreams", 1)], goto: Some("reminder")),
                    (
                        text: "Here's your modem, good as new!",
                        when: [QuestAt("56k_dreams", 2), HasItem("working_modem", 1)],
                        effects: [TakeItem("working_modem", 1), CompleteQuest("56k_dreams")],
                        goto: Some("reward"),
                    ),
                    (text: "How's business?", when: [QuestDone("56k_dreams")], goto: Some("business")),
                    (text: "Can I use the e-Bid terminal?", when: [QuestDone("56k_dreams")], effects: [OpenMarket], goto: None),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "Our modem got fried in last night's storm. No modem, no internet, no customers. Could you find me a replacement?",
                options: [
                    (text: "I'll find you one.", effects: [StartQuest("56k_dreams")], goto: Some("accepted")),
                    (text: "Sorry, not my problem.", goto: None),
                ],
            ),
            (
                id: "accepted",
                text: "You're a star, {name}! Try Sal at Pawn & Pager, just down the street. He has a bit of everything.",
                options: [(text: "On my way.", goto: None)],
            ),
            (
                id: "reminder",
                text: "Every hour offline, another regular goes to the library instead. Hurry!",
                options: [(text: "I'm on it.", goto: None)],
            ),
            (
                id: "reward",
                text: "*plugs it in* ...Beeee-dong-dong-kshhhh! We're online! Here's for your trouble, and take my old pager. I've upgraded to a cell phone.",
                options: [(text: "Thanks, Dot!", goto: None)],
            ),
            (
                id: "business",
                text: "Booming! Everybody wants to check their email and argue on forums. Oh, and we've got e-Bid now. Ask and you can use the terminal.",
                options: [(text: "Glad to hear it.", goto: None)],
            ),
        ],
    ),
    (
        id: "sal",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Pawn & Pager. If it beeps, buzzes or blinks, I buy it. If it's broken, I sell it cheap.",
                options: [
                    (text: "Dot sent me. Got a 56k modem?", when: [QuestAt("56k_dreams", 0)], goto: Some("modem")),
                    (text: "Show me what you've got.", effects: [OpenShop("pawn_shop")], goto: None),
                    (text: "Any advice?", goto: Some("advice")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "modem",
                text: "Got one. Thing's fried, though. Fifteen bucks and it's yours. Fix it yourself and you save a fortune.",
                options: [
                    (
                        text: "Deal. ($15)",
                        when: [Cash(15)],
                        effects: [TakeCash(15), GiveItem("broken_modem", 1), SetQuestStage("56k_dreams", 1)],
                        goto: Some("sold"),
                    ),
                    (text: "I don't have $15 right now.", when: [Not(Cash(15))], goto: None),
                    (text: "Let me think about it.", goto: None),
                ],
            ),
            (
                id: "sold",
                text: "Pleasure doing business. You'll want a screwdriver set for that. Mr. Kim sells them across the street.",
                options: [(text: "Thanks.", goto: None)],
            ),
            (
                id: "advice",
                text: "I buy broken gear cheap and sell it fixed. Learn Electronics and you can do the fixing, and I'll still buy what you fix.",
                options: [(text: "Good to know.", goto: None)],
            ),
        ],
    ),
    (
        id: "kim",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Corner Store 24/7. We never close, not even for Y2K.",
                options: [
                    (text: "Let me see what you have.", effects: [OpenShop("corner_store")], goto: None),
                    (text: "Anything new?", goto: Some("news")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "news",
                text: "I sold forty cans of Fizz Cola to the arcade kids before lunch. Also, someone keeps burning CDs and leaving them in my mailbox.",
                options: [(text: "Weird.", goto: None)],
            ),
        ],
    ),
    (
        id: "pruitt",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Maple & 5th. You look new in town.",
                options: [
                    (text: "First day. Any advice?", when: [QuestNotStarted("welcome")], goto: Some("advice")),
                    (text: "Still getting that soda.", when: [QuestAt("welcome", 0)], goto: Some("reminder")),
                    (
                        text: "Here's your Fizz Cola.",
                        when: [QuestAt("welcome", 1), HasItem("soda", 1)],
                        effects: [TakeItem("soda", 1), CompleteQuest("welcome")],
                        goto: Some("thanks"),
                    ),
                    (text: "About that soda... I drank it.", when: [QuestAt("welcome", 1), Not(HasItem("soda", 1))], goto: Some("drank")),
                    (text: "How do people make money around here?", goto: Some("money")),
                    (text: "See you around.", goto: None),
                ],
            ),
            (
                id: "advice",
                text: "Rule one: never skip lunch. Do me a favor? Mr. Kim's Corner Store is right across Maple Street. Grab me a Fizz Cola, it's a buck. I'd go myself, but I'm on duty.",
                options: [
                    (text: "Sure, one Fizz Cola.", effects: [StartQuest("welcome")], goto: None),
                    (text: "Maybe later.", goto: None),
                ],
            ),
            (
                id: "reminder",
                text: "Corner Store, across the street. Mr. Kim's out front. Fizz Cola. Ice cold, please.",
                options: [(text: "On my way.", goto: None)],
            ),
            (
                id: "drank",
                text: "Ha! Can't blame you. They're a buck at Mr. Kim's. Get me another one.",
                options: [(text: "Fair enough.", goto: None)],
            ),
            (
                id: "thanks",
                text: "Lifesaver. Here, for your trouble, and a first aid kit: you'll want it. Dot at the Byte Cafe, right behind me, always needs something fixed. If you can handle yourself, Foreman Rizzo pays for muscle down at the Harbor Docks; the Metro's at the south-east corner. And watch yourself after dark: the taggers come out.",
                options: [(text: "Thanks, officer.", goto: None)],
            ),
            (
                id: "money",
                text: "Fix things and sell them: Sal at Pawn & Pager sells broken gadgets cheap, and Dot pays for repairs. Hustle at the docks. Or put stuff up on e-Bid, if you've got a modem. Just keep it legal where I can see you.",
                options: [(text: "Got it.", goto: Some("hello"))],
            ),
        ],
    ),
    (
        id: "rizzo",
        start: "hello",
        nodes: [
            (
                id: "smugglers",
                text: "Smugglers. Captain Vance's lot. They run knock-off pagers through my warehouse and my crew takes the heat. Bring some friends who can throw a punch (Fitness 5), and you've got ten minutes before Vance's boat leaves.",
                options: [(text: "We'll handle it.", goto: None)],
            ),
            (id: "ray_delivery", text: "Ray's radios! About time. Here, I signed. Tell that big lug the coffee's on me next time he's in town.", options: [(text: "Will do.", goto: None)]),
            (
                id: "hello",
                text: "Watch your step, kid. The docks ain't Maple Street.",
                options: [
                    (text: "What's going on in Warehouse 7?", goto: Some("smugglers")),
                    (text: "We'll clear out Warehouse 7. (A party of 3 or more)", when: [SkillLevel(Fitness, 5)], effects: [StartRaid("harbor_smugglers")], goto: None),
                    (text: "Delivery from Big Ray.", when: [QuestAt("long_haul", 2), HasItem("cb_crate", 1)], effects: [TakeItem("cb_crate", 1), GiveItem("delivery_receipt", 1), SetQuestStage("long_haul", 3)], goto: Some("ray_delivery")),
                    (text: "Anything I can help with?", when: [QuestNotStarted("rat_problem")], goto: Some("problem")),
                    (text: "Still working on those Dock Rats.", when: [QuestAt("rat_problem", 0)], goto: Some("reminder")),
                    (
                        text: "The Dock Rats won't bother your containers anymore.",
                        when: [QuestAt("rat_problem", 1)],
                        effects: [CompleteQuest("rat_problem")],
                        goto: Some("reward"),
                    ),
                    (text: "Got anything for a friend of the docks?", effects: [OpenShop("dockside_locker")], goto: None),
                    (text: "Who's the big guy by the cranes?", goto: Some("sully")),
                    (text: "See you around.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "The Dock Rats keep swiping stuff off my containers. Knock five of 'em down a peg and they'll get the message. You'll want something better than your fists. Sal sells bats.",
                options: [
                    (text: "Consider it done.", effects: [StartQuest("rat_problem"), ResetKills("dock_rat")], goto: None),
                    (text: "Not my fight.", goto: None),
                ],
            ),
            (
                id: "reminder",
                text: "They hang around the containers in the middle of the yard. Five of 'em.",
                options: [(text: "On it.", goto: None)],
            ),
            (
                id: "reward",
                text: "Ha! Quietest it's been all week. Here, for your trouble. And take a couple of these, you look like you need 'em.",
                options: [(text: "Thanks, Rizzo.", goto: None)],
            ),
            (
                id: "sully",
                text: "Big Sully. Runs the Wharf Hounds. Don't go near him unless you've got friends and a first aid kit.",
                options: [(text: "Noted.", goto: Some("hello"))],
            ),
        ],
    ),
    (
        id: "joey",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Pixel Palace! New releases on the left, used carts on the right, no loitering on the demo kiosk.",
                options: [
                    (text: "Let me browse.", effects: [OpenShop("pixel_palace")], goto: None),
                    (text: "You look busy.", when: [QuestNotStarted("mall_rats")], goto: Some("problem")),
                    (text: "Still collecting CDs for you.", when: [QuestAt("mall_rats", 0)], goto: Some("reminder")),
                    (
                        text: "Here are three burned CDs.",
                        when: [QuestAt("mall_rats", 1), HasItem("burned_cd", 3)],
                        effects: [TakeItem("burned_cd", 3), CompleteQuest("mall_rats")],
                        goto: Some("reward"),
                    ),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "I'm making the ultimate mall mixtape. I need source material: burned CDs, any kind. Bring me three? Mr. Kim downtown sells them, or the Dock Rats always seem to have some.",
                options: [
                    (text: "Three burned CDs, coming up.", effects: [StartQuest("mall_rats")], goto: None),
                    (text: "Not really my thing.", goto: None),
                ],
            ),
            (id: "reminder", text: "Three burned CDs. Any kind. Even the Celine Dion ones.", options: [(text: "On it.", goto: None)]),
            (
                id: "reward",
                text: "Sweet! Here, the first copy is yours. Don't tape over it.",
                options: [(text: "Thanks, Joey.", goto: None)],
            ),
        ],
    ),
    (
        id: "wendy",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Gadget Shack, how can I help you? We pay better than the pawn shop for working gear. Don't tell Sal.",
                options: [
                    (text: "Show me what you've got.", effects: [OpenShop("gadget_shack")], goto: None),
                    (text: "Can I use your e-Bid terminal?", effects: [OpenMarket], goto: None),
                    (text: "What sells best?", goto: Some("tips")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "tips",
                text: "Camcorders. Everyone wants to be a director. We get busted ones in all the time. Fix one up and I'll pay you well for it, if you know what you're doing with a screwdriver.",
                options: [(text: "Good to know.", goto: None)],
            ),
        ],
    ),
    (
        id: "gary",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "No running, no skating, no fighting. This is a family mall.",
                options: [
                    (text: "What's at the factory?", goto: Some("factory")),
                    (text: "Yes, officer.", goto: None),
                ],
            ),
            (
                id: "factory",
                text: "The old Kessler plant? Scrappers stripping copper out of it. Old Earl still runs a salvage stall by the gate. Take the Metro east.",
                options: [(text: "Thanks.", goto: None)],
            ),
        ],
    ),
    (
        id: "earl",
        start: "hello",
        nodes: [
            (
                id: "dogs_offer",
                text: "Three strays moved into the yard. Can't blame 'em, it's warm by the boiler. But they won't let me near my parts. Run 'em off? Don't hurt 'em much.",
                options: [(text: "I'll shoo them.", effects: [StartQuest("junkyard_dogs"), ResetKills("junkyard_dog")], goto: None), (text: "I'm a cat person.", goto: None)],
            ),
            (id: "dogs_done", text: "Quiet at last. Here, take these kits. You look bitten.", options: [(text: "Thanks, Earl.", goto: None)]),
            (
                id: "hello",
                text: "Careful in there. Those Scrappers would strip the fillings out of your teeth.",
                options: [
                    (text: "What's all the barking?", when: [QuestNotStarted("junkyard_dogs")], goto: Some("dogs_offer")),
                    (text: "The yard's clear. No more dogs.", when: [QuestAt("junkyard_dogs", 1)], effects: [CompleteQuest("junkyard_dogs")], goto: Some("dogs_done")),
                    (text: "Need a hand?", when: [QuestNotStarted("scrap_run")], goto: Some("problem")),
                    (text: "Still gathering scrap.", when: [QuestAt("scrap_run", 0)], goto: Some("reminder")),
                    (
                        text: "Here's your scrap metal.",
                        when: [QuestAt("scrap_run", 1), HasItem("scrap_metal", 6)],
                        effects: [TakeItem("scrap_metal", 6), CompleteQuest("scrap_run")],
                        goto: Some("reward"),
                    ),
                    (text: "How's the car coming along?", when: [QuestDone("scrap_run"), QuestNotStarted("junker")], goto: Some("junker_offer")),
                    (text: "About the hatchback...", when: [QuestAt("junker", 0)], goto: Some("junker_reminder")),
                    (
                        text: "I've got everything for the hatchback.",
                        when: [QuestAt("junker", 1), HasItem("carburetor", 1), HasItem("car_battery", 1), HasItem("spark_plug", 2)],
                        effects: [
                            TakeItem("carburetor", 1),
                            TakeItem("car_battery", 1),
                            TakeItem("spark_plug", 2),
                            CompleteQuest("junker"),
                            GiveCar("hatchback"),
                        ],
                        goto: Some("junker_done"),
                    ),
                    (text: "Need anything else?", when: [QuestDone("junker"), QuestNotStarted("parts_run")], goto: Some("parts_offer")),
                    (
                        text: "Got your timing belt.",
                        when: [QuestAt("parts_run", 1), HasItem("timing_belt", 1)],
                        effects: [TakeItem("timing_belt", 1), CompleteQuest("parts_run")],
                        goto: Some("parts_done"),
                    ),
                    (text: "Let's trade.", effects: [OpenShop("earl_salvage")], goto: None),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "I'm rebuilding an old car, but I'm short on scrap metal. Six pieces should do. The Scrappers and Copper Thieves in there carry plenty.",
                options: [
                    (text: "I'll get you six.", effects: [StartQuest("scrap_run")], goto: None),
                    (text: "Maybe later.", goto: None),
                ],
            ),
            (id: "reminder", text: "Six pieces of scrap. The Scrappers hang around the heaps.", options: [(text: "Right.", goto: None)]),
            (
                id: "reward",
                text: "That's the stuff. Take my spare wrench, and watch how I do this. You've got the hands for it.",
                options: [(text: "Thanks, Earl.", goto: None)],
            ),
            (
                id: "junker_offer",
                text: "Body's done, but she still won't start. Tell you what: get her running and she's yours. I need a carburetor, a battery and two spark plugs. The Scrappers carry rusty carbs; rebuild one with that wrench. And you'll want to know what you're doing: Mechanics 3, at least.",
                options: [
                    (text: "Deal.", effects: [StartQuest("junker")], goto: None),
                    (text: "Maybe later.", goto: None),
                ],
            ),
            (
                id: "junker_reminder",
                text: "A carburetor, a car battery, two spark plugs, and Mechanics 3. I sell rusty carbs and plugs if the Scrappers won't give you any.",
                options: [(text: "On it.", goto: None)],
            ),
            (
                id: "parts_offer",
                text: "Now that you've got wheels: my buddy Hank runs a garage out in Pinecrest. He's holding a timing belt for me. Take Maple west onto Route 9 and keep going till the trees thin out.",
                options: [
                    (text: "Road trip!", effects: [StartQuest("parts_run")], goto: None),
                    (text: "Another time.", goto: None),
                ],
            ),
            (
                id: "parts_done",
                text: "Hank wrapped it in the Gazette again. That man. Thanks, kid. How'd she handle on the highway?",
                options: [(text: "Like a dream.", goto: None)],
            ),
            (
                id: "junker_done",
                text: "Listen to that engine! She's all yours, kid. Highway's at the south end of the yard, takes you right onto Maple Street. Go see Dash downtown if you want to race.",
                options: [(text: "Thanks, Earl!", goto: None)],
            ),
        ],
    ),
    (
        id: "dash",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "You here to race, or just to look at the paint jobs?",
                options: [
                    (text: "Let's race.", effects: [StartRace("maple_loop")], goto: None),
                    (text: "How does it work?", goto: Some("rules")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "rules",
                text: "Maple & 5th Sprint. East end of Maple, south end of 5th, north end of 5th, then back here. Fifty seconds. Make it and I'll pay you thirty bucks. Pull up next to me in your car and say the word.",
                options: [(text: "Got it.", goto: None)],
            ),
        ],
    ),
    (
        id: "crystal",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Threads! Everything's 30% off, which means it was overpriced by 30%. Looking for something?",
                options: [
                    (text: "Show me the clothes.", effects: [OpenShop("threads")], goto: None),
                    (text: "Do clothes actually help?", goto: Some("tips")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "tips",
                text: "Duh. A good jacket takes a punch, the right shoes and you're faster on your feet, shades and a cap and you drive like you mean it. Open your inventory and use something to put it on.",
                options: [(text: "Good to know.", goto: None)],
            ),
        ],
    ),
    (
        id: "pemberton",
        start: "hello",
        nodes: [
            (
                id: "retreat_offer",
                text: "The board is holding its retreat at the Pine Motel. Don't ask me why. This briefcase needs to be there, and I don't trust couriers. You have a car, I hear. Drive it out to Pinecrest, give it to the motel manager.",
                options: [
                    (text: "Consider it delivered.", effects: [GiveItem("briefcase", 1), StartQuest("corporate_retreat")], goto: None),
                    (text: "What's in it?", goto: Some("retreat_what")),
                ],
            ),
            (id: "retreat_what", text: "Quarterly projections. Probably. Don't open it.", options: [(text: "Fine.", effects: [GiveItem("briefcase", 1), StartQuest("corporate_retreat")], goto: None), (text: "Pass.", goto: None)]),
            (id: "retreat_done", text: "Splendid. The board is pleased, which means I am pleased, which means you get paid.", options: [(text: "Pleasure.", goto: None)]),
            (
                id: "hello",
                text: "Pemberton, Meridian Corp, Facilities. Make it quick, we have four hundred days to make every computer in this building understand the year 2000.",
                options: [
                    (text: "Anything else for Meridian?", when: [QuestDone("y2k_compliance"), QuestNotStarted("corporate_retreat")], goto: Some("retreat_offer")),
                    (text: "The briefcase arrived.", when: [QuestAt("corporate_retreat", 1)], effects: [CompleteQuest("corporate_retreat")], goto: Some("retreat_done")),
                    (text: "Need help with that?", when: [QuestNotStarted("y2k_compliance")], goto: Some("offer")),
                    (text: "About those modems...", when: [QuestAt("y2k_compliance", 0)], goto: Some("reminder")),
                    (
                        text: "Two working modems, as ordered.",
                        when: [QuestAt("y2k_compliance", 1), HasItem("working_modem", 2)],
                        effects: [TakeItem("working_modem", 2), CompleteQuest("y2k_compliance")],
                        goto: Some("reward"),
                    ),
                    (text: "What does Meridian sell?", effects: [OpenShop("meridian_supply")], goto: None),
                    (text: "What does Meridian think of me?", goto: Some("standing")),
                    (text: "Never mind.", goto: None),
                ],
            ),
            (
                id: "offer",
                text: "Our modems are older than our interns. Bring me two working ones and Meridian will remember your name. Fondly, even. The pawn shop has broken ones; I'm told a screwdriver fixes most things.",
                options: [
                    (text: "Two modems, coming up.", effects: [StartQuest("y2k_compliance")], goto: None),
                    (text: "Not my department.", goto: None),
                ],
            ),
            (id: "reminder", text: "Two. Working. Modems. The clock is ticking, literally.", options: [(text: "On it.", goto: None)]),
            (
                id: "reward",
                text: "Excellent. You're a credit to the private sector. Our supply store will treat you like family now. Well, like a cousin.",
                options: [(text: "Pleasure doing business.", goto: None)],
            ),
            (
                id: "standing",
                text: "Meridian rewards loyalty. Help us and our store gives you better prices, and the good stuff: suits, PalmPilots. Check your standing in your skills window.",
                options: [(text: "Noted.", goto: None)],
            ),
        ],
    ),
    (
        id: "flo",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Sit anywhere, hon. Unless you can cook. Can you cook? My fry cook ran off to be in a band.",
                options: [
                    (text: "I can cook.", when: [QuestNotStarted("lunch_rush")], goto: Some("offer")),
                    (text: "Still on those sandwiches.", when: [QuestAt("lunch_rush", 0)], goto: Some("reminder")),
                    (
                        text: "Three grilled cheese, order up!",
                        when: [QuestAt("lunch_rush", 1), HasItem("grilled_cheese", 3)],
                        effects: [TakeItem("grilled_cheese", 3), CompleteQuest("lunch_rush")],
                        goto: Some("reward"),
                    ),
                    (text: "What's on the menu?", effects: [OpenShop("sunny_side")], goto: None),
                    (text: "Just looking.", goto: None),
                ],
            ),
            (
                id: "offer",
                text: "Prove it. Three grilled cheese for the lunch rush. Doug at the grocery has bread and cheese, and he'll sell you a pan. Use the cheese to start cooking.",
                options: [
                    (text: "Coming right up.", effects: [StartQuest("lunch_rush")], goto: None),
                    (text: "On second thought...", goto: None),
                ],
            ),
            (id: "reminder", text: "Three grilled cheese, golden brown. The truckers are getting restless.", options: [(text: "Working on it.", goto: None)]),
            (
                id: "reward",
                text: "Now THAT is a sandwich. Here, take the hat, it's yours. And if you ever cook more than you can eat, I'll buy it off you.",
                options: [(text: "Thanks, Flo.", goto: None)],
            ),
        ],
    ),
    (
        id: "doug",
        start: "hello",
        nodes: [
            (
                id: "watch_offer",
                text: "Eggs on my windows, toilet paper in my trees. Run four of them off and I'll give you something for that house of yours. Or the house you'll have one day.",
                options: [
                    (text: "Neighborhood Watch, reporting for duty.", effects: [ResetKills("prankster"), StartQuest("neighborhood_watch")], goto: None),
                    (text: "Kids will be kids.", goto: None),
                ],
            ),
            (id: "watch_reminder", text: "Four pranksters. They hang around the backyards behind the houses.", options: [(text: "On it.", goto: None)]),
            (id: "watch_done", text: "Peace and quiet! Here, an army footlocker. Every house needs one.", options: [(text: "Thanks, Doug.", goto: None)]),
            (
                id: "hello",
                text: "Welcome to Value Grocer, where the value is... somewhere. Aisle six, probably.",
                options: [
                    (text: "Those pranksters out back...", when: [QuestNotStarted("neighborhood_watch")], goto: Some("watch_offer")),
                    (text: "Still on prankster patrol.", when: [QuestAt("neighborhood_watch", 0)], goto: Some("watch_reminder")),
                    (text: "The pranksters are gone.", when: [QuestAt("neighborhood_watch", 1)], effects: [CompleteQuest("neighborhood_watch")], goto: Some("watch_done")),
                    (text: "Let me see what you've got.", effects: [OpenShop("value_grocer")], goto: None),
                    (text: "Any cooking tips?", goto: Some("tips")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "tips",
                text: "Grilled cheese and eggs, anybody can do. Coffee you've gotta know your beans, Cooking 2. Burgers, Cooking 3. And watch out for the pranksters out back, they've been egging the houses.",
                options: [(text: "Thanks, Doug.", goto: None)],
            ),
        ],
    ),
    (
        id: "payphone",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A scratched payphone. Quarters only. The coin box hasn't been emptied in a while, and the handset cord looks easy to tap.",
                options: [
                    (text: "Hack it.", effects: [Hack("payphone")], goto: None),
                    (text: "Make a call.", goto: Some("call")),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
            (id: "call", text: "You get a busy signal, then a modem squeal, then someone saying \"wrong number, narc\". Click.", options: [(text: "Hang up.", goto: None)]),
        ],
    ),
    (
        id: "atm",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A Meridian Corp ATM. The screen says WELCOME in a font from 1987. There is a maintenance port under the keypad.",
                options: [
                    (text: "Hack it.", effects: [Hack("meridian_atm")], goto: None),
                    (text: "Check my balance.", goto: Some("balance")),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
            (id: "balance", text: "INSUFFICIENT FUNDS. HAVE A MERIDIAN DAY.", options: [(text: "Rude.", goto: None)]),
        ],
    ),
    (
        id: "arcade",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Street Kombat II. The high-score table is full of initials you don't know. The coin door is held shut with tape.",
                options: [
                    (text: "Hack it.", effects: [Hack("arcade_highscore")], goto: None),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "factory_panel",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A rusty keypad by the Main Hall doors. A sticker says SECURITY BY KRANKCO. The wires run somewhere warm.",
                options: [
                    (text: "Hack it.", effects: [Hack("factory_panel")], goto: None),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "harbor_terminal",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A beige terminal behind the Harbor Office window, still logged in to SHIPPING-MGR. Green text blinks patiently.",
                options: [
                    (text: "Hack it.", effects: [Hack("harbor_office")], goto: None),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "glitch",
        start: "hello",
        nodes: [
            (
                id: "ghost_read",
                text: "Ha! That's ours. A relay for the pirate radio, bouncing the signal off the church tower. We lost it last fall. The Pinecrest ghost is... us. Don't tell the sheriff.",
                options: [(text: "Our secret.", goto: None)],
            ),
            (
                id: "hello",
                text: "...You're blocking my signal. What do you want?",
                options: [
                    (
                        text: "Can you read this floppy? GHOST.EXE.",
                        when: [QuestAt("ghost_in_the_machine", 0), HasItem("strange_floppy", 1)],
                        effects: [TakeItem("strange_floppy", 1), CompleteQuest("ghost_in_the_machine")],
                        goto: Some("ghost_read"),
                    ),
                    (text: "I heard you're a hacker.", when: [QuestNotStarted("phreaking_101")], goto: Some("intro")),
                    (text: "Still working on that payphone.", when: [QuestAt("phreaking_101", 0)], goto: Some("phone_reminder")),
                    (text: "The payphone's mine.", when: [QuestAt("phreaking_101", 1)], effects: [CompleteQuest("phreaking_101")], goto: Some("welcome")),
                    (
                        text: "Got a real job for me?",
                        when: [QuestDone("phreaking_101"), QuestNotStarted("black_ice"), Rep("zeros", 100)],
                        goto: Some("black_ice"),
                    ),
                    (text: "About the Harbor Office...", when: [QuestAt("black_ice", 0)], goto: Some("ice_reminder")),
                    (text: "Here are your manifests.", when: [QuestAt("black_ice", 1)], effects: [CompleteQuest("black_ice")], goto: Some("ice_done")),
                    (text: "What've you got?", when: [QuestDone("phreaking_101")], effects: [OpenShop("zeros_stash")], goto: None),
                    (text: "How does hacking work?", goto: Some("howto")),
                    (text: "Never mind.", goto: None),
                ],
            ),
            (
                id: "intro",
                text: "Hacker is a strong word. I \"explore systems\". Want in? Prove it. The payphone on the corner of Maple & 5th. Make it yours.",
                options: [
                    (text: "Easy.", effects: [StartQuest("phreaking_101")], goto: None),
                    (text: "Sounds illegal.", goto: None),
                ],
            ),
            (id: "phone_reminder", text: "The payphone. Corner of Maple & 5th. It's not going to hack itself.", options: [(text: "Right.", goto: None)]),
            (
                id: "welcome",
                text: "Not bad for a newbie. Take this coupler, it'll make you faster. Welcome to Zer0 Day. We never met.",
                options: [(text: "Never met who?", goto: None)],
            ),
            (
                id: "black_ice",
                text: "The Dockside Crew is moving something through the harbor and Meridian is paying them to. The manifests are on the Harbor Office terminal. That system's no payphone: Hacking 6, and you'll want gear.",
                options: [
                    (text: "I'm in.", effects: [StartQuest("black_ice")], goto: None),
                    (text: "Not yet.", goto: None),
                ],
            ),
            (id: "ice_reminder", text: "Harbor Office terminal, docks. Hacking 6. Don't trip the alarm.", options: [(text: "Got it.", goto: None)]),
            (
                id: "ice_done",
                text: "Meridian AND the Dockside Crew. I knew it. Here, you've earned a real machine. Don't tell anyone where you got it.",
                options: [(text: "Where did I get what?", goto: None)],
            ),
            (
                id: "howto",
                text: "Talk to a system and choose Hack. You get a code for a second, memorize it, type it in before the timer runs out. Higher Hacking, easier codes. Gear helps. Mess up and the alarm goes, and City Services don't like that.",
                options: [(text: "Cool.", goto: None)],
            ),
        ],
    ),
    (
        id: "vinnie",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Dogs! Hot dogs! Best thing open after eight, guaranteed, because nothing else is open after eight.",
                options: [
                    (text: "One dog, everything on it.", effects: [OpenShop("late_night_dogs")], goto: None),
                    (text: "Quiet night?", goto: Some("night")),
                    (text: "Later, Vinnie.", goto: None),
                ],
            ),
            (
                id: "night",
                text: "Quiet? The taggers come out after dark. Spray cans everywhere. City Services pays good attention to anybody who runs 'em off, if you catch my drift.",
                options: [(text: "Caught.", goto: None)],
            ),
        ],
    ),
    (
        id: "skyler",
        start: "hello",
        nodes: [
            (
                id: "radio_offer",
                text: "Somebody locked me out of my own junction box. The station's been playing the same Celine Dion song for two days. Hack it back for me?",
                options: [(text: "I'll fix it.", effects: [StartQuest("radio_free_maple")], goto: None), (text: "I like Celine.", goto: None)],
            ),
            (id: "radio_reminder", text: "The junction box by the antenna. It's a tough one, Hacking 5 or so.", options: [(text: "Right.", goto: None)]),
            (id: "radio_done", text: "Radio Free Maple lives! Here, a poster from the last show. This one goes out to you.", options: [(text: "Rock on.", goto: None)]),
            (
                id: "hello",
                text: "Welcome to the top of the world! Well, the top of the Riverside Apartments. You're listening to Radio Free Maple, 87.9, as long as nobody finds the antenna.",
                options: [
                    (text: "Need help with the station?", when: [QuestNotStarted("radio_free_maple")], goto: Some("radio_offer")),
                    (text: "About the antenna...", when: [QuestAt("radio_free_maple", 0)], goto: Some("radio_reminder")),
                    (text: "You're back on the air.", when: [QuestAt("radio_free_maple", 1)], effects: [CompleteQuest("radio_free_maple")], goto: Some("radio_done")),
                    (text: "How did you get a radio station up here?", goto: Some("radio")),
                    (text: "Anything interesting up here?", goto: Some("secrets")),
                    (text: "Keep it down.", goto: None),
                ],
            ),
            (
                id: "radio",
                text: "Borrowed transmitter, borrowed power, borrowed roof. Zer0 Day helped me patch into the old junction box by the antenna. If you know what you're doing you can make it play anything.",
                options: [(text: "Cool.", goto: None)],
            ),
            (
                id: "secrets",
                text: "People have been coming up here since the seventies. Somebody always hides something. I'd check the vents, if I were you. Not that I'm telling you to.",
                options: [(text: "Noted.", goto: None)],
            ),
        ],
    ),
    (
        id: "antenna",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A junction box zip-tied to the antenna mast. Cables run to Skyler's speakers. A sticker reads ZER0 DAY WAS HERE.",
                options: [
                    (text: "Hack it.", effects: [Hack("pirate_antenna")], goto: None),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "vent",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A vent cover hangs by one screw. It rattles in the wind.",
                options: [
                    (
                        text: "Reach inside.",
                        when: [QuestNotStarted("rooftop_stash")],
                        effects: [StartQuest("rooftop_stash"), CompleteQuest("rooftop_stash")],
                        goto: Some("found"),
                    ),
                    (text: "Leave it.", goto: None),
                ],
            ),
            (
                id: "found",
                text: "A shoebox, wrapped in a trash bag: a stack of old bills and a bootleg concert CD. Finders keepers.",
                options: [(text: "Nice.", goto: None)],
            ),
        ],
    ),
    (
        id: "rhonda",
        start: "hello",
        nodes: [
            (
                id: "coffee_offer",
                text: "Coffee machine died this morning. You know how many truckers come through here? Brew me three thermoses and I'll owe you.",
                options: [(text: "Three coffees, coming up.", effects: [StartQuest("running_on_empty")], goto: None), (text: "I don't drink coffee.", goto: None)],
            ),
            (id: "coffee_done", text: "You're a lifesaver. Here, Mo left this cap. He won't miss it.", options: [(text: "Thanks, Rhonda.", goto: None)]),
            (id: "postcard", text: "For Kat's zine? On the house. Tell her it's spelled with the hyphens.", options: [(text: "Thanks, Rhonda.", goto: None)]),
            (
                id: "hello",
                text: "Gas-N-Go, last stop for coffee till Pinecrest. Pump's broken, before you ask.",
                options: [
                    (text: "Anything I can help with?", when: [QuestNotStarted("running_on_empty")], goto: Some("coffee_offer")),
                    (text: "Kat sent me for a postcard.", when: [QuestAt("road_trip", 0)], effects: [GiveItem("gas_n_go_postcard", 1)], goto: Some("postcard")),
                    (text: "Here's your coffee.", when: [QuestAt("running_on_empty", 1), HasItem("diner_coffee", 3)], effects: [TakeItem("diner_coffee", 3), CompleteQuest("running_on_empty")], goto: Some("coffee_done")),
                    (text: "What've you got?", effects: [OpenShop("gas_n_go")], goto: None),
                    (text: "Where does this road go?", goto: Some("road")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "road",
                text: "West is Pinecrest, nice little town, nothing happens there, and past it the Mile 88 truck stop. The turnoff north goes up to Hollow Pines State Park, the one south down to Lake Wren. East takes you back into the city. Bus stops right outside if you're on foot.",
                options: [(text: "Thanks.", goto: None)],
            ),
        ],
    ),
    (
        id: "trucker_mo",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Twenty years on this road. Bet you can't do the Route 9 Run: out to the east mile marker, then back past here and on to the west marker. Thirty-two seconds.",
                options: [
                    (text: "Watch me.", effects: [StartRace("route_9_run")], goto: None),
                    (text: "Maybe later.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "hank",
        start: "hello",
        nodes: [
            (
                id: "paint",
                text: "Sixty bucks, any color you like, as long as it's on this card. Park it out front first.",
                options: [
                    (text: "Cherry Red.", effects: [PaintCar(0, 60)], goto: None),
                    (text: "Midnight Black.", effects: [PaintCar(1, 60)], goto: None),
                    (text: "Pearl White.", effects: [PaintCar(2, 60)], goto: None),
                    (text: "Teal.", effects: [PaintCar(3, 60)], goto: None),
                    (text: "Purple Haze.", effects: [PaintCar(4, 60)], goto: None),
                    (text: "Highlighter Yellow.", effects: [PaintCar(5, 60)], goto: None),
                    (text: "Forest Green.", effects: [PaintCar(6, 60)], goto: None),
                    (text: "Electric Blue.", effects: [PaintCar(7, 60)], goto: None),
                    (text: "Never mind.", goto: None),
                ],
            ),
            (
                id: "parts",
                text: "Bring the parts, I'll fit 'em, no charge. I sell tires and body kits; for a turbo you want Wanda out at the Mile 88 truck stop. Car's got to be parked out front.",
                options: [
                    (text: "Fit the Turbo Kit.", when: [HasItem("turbo_kit", 1)], effects: [InstallPart("turbo_kit")], goto: None),
                    (text: "Fit the Sport Tires.", when: [HasItem("sport_tires", 1)], effects: [InstallPart("sport_tires")], goto: None),
                    (text: "Fit the Body Kit.", when: [HasItem("body_kit", 1)], effects: [InstallPart("body_kit")], goto: None),
                    (text: "Never mind.", goto: None),
                ],
            ),
            (
                id: "hello",
                text: "Hank's Garage. If it's got an engine, I've had my arm in it.",
                options: [
                    (
                        text: "Earl sent me for a timing belt.",
                        when: [QuestAt("parts_run", 0)],
                        effects: [GiveItem("timing_belt", 1), SetQuestStage("parts_run", 1)],
                        goto: Some("belt"),
                    ),
                    (text: "Need anything?", when: [QuestNotStarted("scenic_route")], goto: Some("scenic_offer")),
                    (text: "About the lookout footage...", when: [QuestAt("scenic_route", 0)], goto: Some("scenic_reminder")),
                    (text: "Here's your lookout footage.", when: [QuestAt("scenic_route", 1)], effects: [CompleteQuest("scenic_route")], goto: Some("scenic_done")),
                    (text: "Paint my car. ($60)", goto: Some("paint")),
                    (text: "Can you fit some parts?", goto: Some("parts")),
                    (text: "Show me your parts.", effects: [OpenShop("hanks_garage")], goto: None),
                    (text: "See you.", goto: None),
                ],
            ),
            (id: "belt", text: "One timing belt, wrapped for freshness. Tell Earl he owes me a fishing trip.", options: [(text: "Will do.", goto: None)]),
            (
                id: "scenic_offer",
                text: "My wife wants a video of the Hollow Pines lookout for her sister in Florida. I'd go, but somebody has to watch the garage. You got a camcorder that works?",
                options: [
                    (text: "I'll get you footage.", effects: [StartQuest("scenic_route")], goto: None),
                    (text: "Not really my thing.", goto: None),
                ],
            ),
            (id: "scenic_reminder", text: "Up the turnoff off Route 9, past the ranger station, all the way to the railing. Bring a working camcorder.", options: [(text: "Right.", goto: None)]),
            (
                id: "scenic_done",
                text: "Look at that view! She's gonna cry. Here, take my old road atlas. Every back road in the state, plus some that aren't there anymore.",
                options: [(text: "Thanks, Hank.", goto: None)],
            ),
        ],
    ),
    (
        id: "sheriff_ruth",
        start: "hello",
        nodes: [
            (
                id: "ghost_offer",
                text: "Folks say the church bell tower lights up at night. Pastor says it's not him. I say it's kids. Take a look after dark, would you? Tower door's on Main Street.",
                options: [
                    (text: "Does the county sell its surplus?", effects: [OpenShop("county_surplus")], goto: None),(text: "I'll look into it.", effects: [StartQuest("pinecrest_ghost")], goto: None), (text: "I don't believe in ghosts.", goto: None)],
            ),
            (
                id: "ghost_found",
                text: "GHOST.EXE? That's no ghost, that's a computer. I can't make heads or tails of it. Keep it, and find somebody who can. Thank you kindly.",
                options: [(text: "I know someone.", goto: None)],
            ),
            (
                id: "hello",
                text: "Afternoon. Pinecrest is a quiet town and I aim to keep it that way. You staying long?",
                options: [
                    (text: "Anything strange going on?", when: [QuestNotStarted("pinecrest_ghost")], goto: Some("ghost_offer")),
                    (
                        text: "I found this floppy in the bell tower.",
                        when: [QuestAt("pinecrest_ghost", 1), HasItem("strange_floppy", 1)],
                        effects: [CompleteQuest("pinecrest_ghost"), StartQuest("ghost_in_the_machine")],
                        goto: Some("ghost_found"),
                    ),
                    (text: "Anything going on?", goto: Some("news")),
                    (text: "Just passing through.", goto: None),
                ],
            ),
            (
                id: "news",
                text: "Poachers up in Hollow Pines, and kids from the city racing on Route 9. Ranger Dale could use a hand with the first one. The second one, I didn't hear about.",
                options: [(text: "Understood.", goto: None)],
            ),
        ],
    ),
    (
        id: "ranger_dale",
        start: "hello",
        nodes: [
            (
                id: "deer_offer",
                text: "Herd count's due and my knee's shot. The deer spook if you so much as look at them, but they won't leave their patch of woods. Walk one into a corner and clip a tag on. Three should do.",
                options: [(text: "Three deer. Got it.", effects: [StartQuest("deer_count"), ResetKills("deer")], goto: None), (text: "Not today.", goto: None)],
            ),
            (id: "deer_done", text: "Good numbers. The herd's healthy, no thanks to those poachers. Here's something for your trouble.", options: [(text: "Thanks, Dale.", goto: None)]),
            (
                id: "trail_offer",
                text: "Litterbugs. Campers who leave their soda cans in the lake. Three of them, at least, need to be shown the exit.",
                options: [(text: "I'll show them.", effects: [ResetKills("litterbug"), StartQuest("trail_mix")], goto: None), (text: "Not today.", goto: None)],
            ),
            (id: "trail_done", text: "The lake thanks you. Here, a hat. Sun's brutal up here.", options: [(text: "Thanks, Dale.", goto: None)]),
            (
                id: "hello",
                text: "Welcome to Hollow Pines. Take only pictures, leave only footprints. And watch out for poachers, they've been setting traps all over the woods.",
                options: [
                    (text: "Need help with the wildlife?", when: [QuestNotStarted("deer_count")], goto: Some("deer_offer")),
                    (text: "Three deer, tagged and counted.", when: [QuestAt("deer_count", 1)], effects: [CompleteQuest("deer_count")], goto: Some("deer_done")),
                    (text: "Anything else?", when: [QuestDone("leave_no_trace"), QuestNotStarted("trail_mix")], goto: Some("trail_offer")),
                    (text: "The campsites are clean.", when: [QuestAt("trail_mix", 1)], effects: [CompleteQuest("trail_mix")], goto: Some("trail_done")),
                    (text: "Want me to deal with them?", when: [QuestNotStarted("leave_no_trace")], goto: Some("offer")),
                    (text: "Still working on it.", when: [QuestAt("leave_no_trace", 0)], goto: Some("reminder")),
                    (text: "The poachers are gone.", when: [QuestAt("leave_no_trace", 1)], effects: [CompleteQuest("leave_no_trace")], goto: Some("reward")),
                    (text: "Enjoy the park.", goto: None),
                ],
            ),
            (
                id: "offer",
                text: "I can't arrest anybody, I'm a park ranger. But if three of them were to get run off, I'd be grateful, and so would City Services.",
                options: [
                    (text: "Consider it done.", effects: [ResetKills("poacher"), StartQuest("leave_no_trace")], goto: None),
                    (text: "Sounds dangerous.", goto: None),
                ],
            ),
            (id: "reminder", text: "Three poachers. They hang around the woods east and west of the lake.", options: [(text: "On it.", goto: None)]),
            (
                id: "reward",
                text: "The deer thank you. Here, a spare pair of boots. They'll treat you better than those city shoes.",
                options: [(text: "Thanks, Dale.", goto: None)],
            ),
        ],
    ),
    (
        id: "lookout",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "The whole valley spreads out below: the lake, the pines, Route 9 like a grey ribbon, and the city skyline far away.",
                options: [
                    (
                        text: "Film it with your camcorder.",
                        when: [QuestAt("scenic_route", 0), HasItem("camcorder", 1)],
                        effects: [SetQuestStage("scenic_route", 1)],
                        goto: Some("filmed"),
                    ),
                    (text: "Take it in.", goto: Some("view")),
                    (text: "Leave.", goto: None),
                ],
            ),
            (id: "filmed", text: "Two minutes of panorama, slightly shaky, with you narrating. Hank's wife will love it.", options: [(text: "Done.", goto: None)]),
            (id: "view", text: "You stand there a while. It's quiet up here.", options: [(text: "...", goto: None)]),
        ],
    ),
    (
        id: "house_door_1",
        start: "hello",
        nodes: [(id: "hello", text: "A front door with a brass knocker.", options: [(text: "Go up to the door.", effects: [House(1)], goto: None), (text: "Leave.", goto: None)])],
    ),
    (
        id: "house_door_2",
        start: "hello",
        nodes: [(id: "hello", text: "A front door with a brass knocker.", options: [
                    (
                        text: "Leave a newspaper on the step.",
                        when: [QuestAt("paper_route", 0), HasItem("newspapers", 1)],
                        effects: [TakeItem("newspapers", 1), SetQuestStage("paper_route", 1)],
                        goto: None,
                    ),(text: "Go up to the door.", effects: [House(2)], goto: None), (text: "Leave.", goto: None)])],
    ),
    (
        id: "house_door_3",
        start: "hello",
        nodes: [(id: "hello", text: "A front door with a brass knocker.", options: [(text: "Go up to the door.", effects: [House(3)], goto: None), (text: "Leave.", goto: None)])],
    ),
    (
        id: "house_door_4",
        start: "hello",
        nodes: [(id: "hello", text: "A front door with a brass knocker.", options: [
                    (
                        text: "Leave a newspaper on the step.",
                        when: [QuestAt("paper_route", 1), HasItem("newspapers", 1)],
                        effects: [TakeItem("newspapers", 1), SetQuestStage("paper_route", 2)],
                        goto: None,
                    ),(text: "Go up to the door.", effects: [House(4)], goto: None), (text: "Leave.", goto: None)])],
    ),
    (
        id: "house_door_5",
        start: "hello",
        nodes: [(id: "hello", text: "A front door with a brass knocker.", options: [
                    (
                        text: "Leave a newspaper on the step.",
                        when: [QuestAt("paper_route", 2), HasItem("newspapers", 1)],
                        effects: [TakeItem("newspapers", 1), SetQuestStage("paper_route", 3)],
                        goto: None,
                    ),(text: "Go up to the door.", effects: [House(5)], goto: None), (text: "Leave.", goto: None)])],
    ),
    (
        id: "marge",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Home Comforts! Everything for the home, dear. Are you buying or browsing? Well, look around either way.",
                options: [
                    (text: "Show me the furniture.", effects: [OpenShop("home_comforts")], goto: None),
                    (text: "Any houses for sale around here?", goto: Some("houses")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "houses",
                text: "Five on the market right now, $400 each, ask at the front door. Once you're in, buy some furniture and use it at home to put it down. A stove for cooking, a workbench, a computer, a waterbed... a footlocker for your things.",
                options: [(text: "Thanks, Marge.", goto: None)],
            ),
        ],
    ),
    (
        id: "kevin",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Aw man, flat tire. Mr. Henderson is gonna kill me if his paper's late again.",
                options: [
                    (text: "I can deliver them.", when: [QuestNotStarted("paper_route")], effects: [GiveItem("newspapers", 3), StartQuest("paper_route")], goto: Some("route")),
                    (text: "All delivered.", when: [QuestAt("paper_route", 3)], effects: [CompleteQuest("paper_route")], goto: Some("done")),
                    (text: "Bummer, kid.", goto: None),
                ],
            ),
            (id: "route", text: "Really? Three Willow Court first, then Four Willow Court, then Twenty Oak Lane. Just leave them on the step!", options: [(text: "Got it.", goto: None)]),
            (id: "done", text: "You're the best! Here, I got these skate shoes for my birthday but they're too big. They'll fit you.", options: [(text: "Thanks, Kevin.", goto: None)]),
        ],
    ),
    (
        id: "dolores",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to the Pine Motel. Cable TV, ice machine, no vacancies... well, all vacancies. Except this week.",
                options: [
                    (text: "You look worried.", when: [QuestNotStarted("motel_mixup")], goto: Some("keys_offer")),
                    (text: "Found your keys.", when: [QuestAt("motel_mixup", 1), HasItem("motel_keys", 1)], effects: [TakeItem("motel_keys", 1), CompleteQuest("motel_mixup")], goto: Some("keys_done")),
                    (
                        text: "A briefcase from Meridian Corp.",
                        when: [QuestAt("corporate_retreat", 0), HasItem("briefcase", 1)],
                        effects: [TakeItem("briefcase", 1), SetQuestStage("corporate_retreat", 1)],
                        goto: Some("briefcase"),
                    ),
                    (text: "Just looking.", goto: None),
                ],
            ),
            (
                id: "keys_offer",
                text: "I dropped every room key I own up at the Hollow Pines lookout, taking pictures. And a whole corporate board arrives tomorrow! Could you look for them?",
                options: [(text: "I'll find them.", effects: [StartQuest("motel_mixup")], goto: None), (text: "Good luck.", goto: None)],
            ),
            (id: "keys_done", text: "Oh thank heavens. Here, for your trouble, and the gas.", options: [(text: "Anytime.", goto: None)]),
            (id: "briefcase", text: "For the board, yes. I'll put it in room six. It's ticking, did you notice? Probably a clock.", options: [(text: "Probably.", goto: None)]),
        ],
    ),
    (
        id: "bell_tower",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "The tower door is unlocked. A green light blinks way up in the belfry.",
                options: [
                    (text: "Climb up and look.", when: [QuestAt("pinecrest_ghost", 0)], effects: [GiveItem("strange_floppy", 1), SetQuestStage("pinecrest_ghost", 1)], goto: Some("found")),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
            (id: "found", text: "Behind the bell: a box of circuit boards, a car battery, and a floppy disk in the drive. GHOST.EXE. You take the disk.", options: [(text: "Spooky.", goto: None)]),
        ],
    ),
    (
        id: "glinting_keys",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Something shiny in the grass by the trail.",
                options: [
                    (text: "Pick it up.", when: [QuestAt("motel_mixup", 0)], effects: [GiveItem("motel_keys", 1), SetQuestStage("motel_mixup", 1)], goto: Some("found")),
                    (text: "Leave it.", goto: None),
                ],
            ),
            (id: "found", text: "A ring of keys on a plastic diamond: PINE MOTEL.", options: [(text: "Found them.", goto: None)]),
        ],
    ),
    // --- The Y2K event.
    (
        id: "y2k_terminal",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "The screen flickers: 01/01/1900 00:00. ERROR: CENTURY NOT FOUND. Somewhere, a modem is screaming.",
                options: [
                    (text: "Reboot it and patch the date. (Screwdriver Set)", when: [HasItem("screwdriver_set", 1)], effects: [EventTask("terminal")], goto: Some("fixed")),
                    (text: "I'd need a Screwdriver Set for this.", when: [Not(HasItem("screwdriver_set", 1))], goto: None),
                    (text: "Leave it.", goto: None),
                ],
            ),
            (
                id: "fixed",
                text: "The screen goes black, beeps twice, and reads 01/01/2000. One terminal at a time.",
                options: [(text: "Next!", goto: None)],
            ),
        ],
    ),
    (
        id: "y2k_generator",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "The Metro's backup generator coughs and dies. A sticker on the side says Y2K COMPLIANT (PROBABLY).",
                options: [
                    (text: "Get it running again. (Wrench)", when: [HasItem("wrench", 1)], effects: [EventTask("generator")], goto: Some("fixed")),
                    (text: "I'd need a Wrench for this.", when: [Not(HasItem("wrench", 1))], goto: None),
                    (text: "Leave it.", goto: None),
                ],
            ),
            (
                id: "fixed",
                text: "It roars back to life. Down the tunnel, a train sighs with relief.",
                options: [(text: "Who's next?", goto: None)],
            ),
        ],
    ),
    (
        id: "y2k_commuter",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "The trains stopped at midnight. My pager says it's 1900. I just want to go home.",
                options: [
                    (text: "Here, have some hot cocoa.", when: [HasItem("hot_cocoa", 1)], effects: [TakeItem("hot_cocoa", 1), EventTask("cocoa")], goto: Some("thanks")),
                    (text: "Hang in there. The Metro will be back soon.", goto: None),
                ],
            ),
            (
                id: "thanks",
                text: "Oh, you're a lifesaver. Happy New Year!",
                options: [(text: "Happy 2000!", goto: None)],
            ),
        ],
    ),
    // --- Milestone 15.
    (
        id: "kat",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Spin City got the new Wilco on vinyl. Not that I can afford it. Every cent's going into my zine.",
                options: [
                    (text: "A zine about what?", when: [QuestNotStarted("road_trip")], goto: Some("pitch")),
                    (text: "What do you need again?", when: [Not(QuestNotStarted("road_trip")), Not(QuestDone("road_trip")), Not(QuestAt("road_trip", 3))], goto: Some("remind")),
                    (
                        text: "Postcard, loon, menu. All yours.",
                        when: [QuestAt("road_trip", 3), HasItem("gas_n_go_postcard", 1), HasItem("carved_loon", 1), HasItem("signed_menu", 1)],
                        effects: [TakeItem("gas_n_go_postcard", 1), TakeItem("carved_loon", 1), TakeItem("signed_menu", 1), CompleteQuest("road_trip")],
                        goto: Some("thanks"),
                    ),
                    (text: "How's the zine?", when: [QuestDone("road_trip")], goto: Some("after")),
                    (text: "See you.", goto: None),
                ],
            ),
            (
                id: "pitch",
                text: "Route 9 Revisited: every weird stop between here and the state line. Problem: no car. You've got wheels, right? Bring me a postcard from the Gas-N-Go, one of Gus's carved loons from Lake Wren and a signed menu from Mama Jo's at the Mile 88 truck stop.",
                options: [(text: "Road trip. I'm in.", effects: [StartQuest("road_trip")], goto: None), (text: "Gas is expensive.", goto: None)],
            ),
            (
                id: "remind",
                text: "A postcard from the Gas-N-Go, a carved loon from Gus in Lake Wren (south off Route 9) and Mama Jo's signed menu. The truck stop's past Pinecrest. In that order, the way the road goes.",
                options: [(text: "On it.", goto: None)],
            ),
            (
                id: "thanks",
                text: "These are perfect. The loon's going on the cover. Here: half my record money, and my old jacket. It's been down that road more times than me. Oh, and the trucker at Mile 88, Big Ray? He's always looking for drivers.",
                options: [(text: "Rock on.", goto: None)],
            ),
            (id: "after", text: "Issue one's at the copy shop. Forty copies, thirty-nine to go.", options: [(text: "I'll take one.", goto: None)]),
        ],
    ),
    (
        id: "gus",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Bait & Tackle. Worms, minnows, rods, and the truth about the one that got away.",
                options: [
                    (text: "Kat sent me for one of your loons.", when: [QuestAt("road_trip", 1)], goto: Some("loon")),
                    (text: "Need a hand?", when: [QuestNotStarted("gone_fishing")], goto: Some("offer")),
                    (text: "Three perch, fresh.", when: [QuestAt("gone_fishing", 1), HasItem("lake_perch", 3)], effects: [TakeItem("lake_perch", 3), CompleteQuest("gone_fishing")], goto: Some("done")),
                    (text: "Let me see the shelves.", effects: [OpenShop("bait_and_tackle")], goto: None),
                    (text: "How do I fish?", goto: Some("howto")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "loon",
                text: "Kat! Good kid. Tell you what: catch me a perch and the loon's yours. The pier's at the end of Lakeshore Road.",
                options: [
                    (text: "Here's a perch.", when: [HasItem("lake_perch", 1)], effects: [TakeItem("lake_perch", 1), GiveItem("carved_loon", 1)], goto: Some("loon_done")),
                    (text: "I'll be back.", goto: None),
                ],
            ),
            (id: "loon_done", text: "Not bad for a city kid. Here's your loon. Don't let her paint it.", options: [(text: "Thanks, Gus.", goto: None)]),
            (
                id: "offer",
                text: "Cooler's empty and the Lodge wants perch for the fish fry. Bring me three and I'll set you up with bait.",
                options: [(text: "Three perch. Got it.", effects: [StartQuest("gone_fishing")], goto: None), (text: "Not today.", goto: None)],
            ),
            (id: "done", text: "Now that's a mess of perch. Take some worms and minnows, you've earned them.", options: [(text: "Tight lines.", goto: None)]),
            (
                id: "howto",
                text: "Rod in your bag, bait in your bag. Stand at the end of the pier and use the bait. Then hold still. Nightcrawlers for perch. Once you can cook a bit (Cooking 4), minnows get you walleye.",
                options: [(text: "Thanks.", goto: None)],
            ),
        ],
    ),
    (
        id: "marlene",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Loon's Lodge. Fish fry Fridays, karaoke Saturdays, regret Sundays.",
                options: [
                    (text: "What's cooking?", effects: [OpenShop("loons_lodge")], goto: None),
                    (text: "What is there to do around here?", goto: Some("town")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "town",
                text: "Fish, mostly. Rent a cabin, pretend you're Thoreau. Gus sells the bait. And the kids swear there's something living in the boathouse. Probably just the kids.",
                options: [(text: "Probably.", goto: None)],
            ),
        ],
    ),
    (
        id: "fishing_spot",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "The end of the pier. Water laps at the posts, and something big rolls out past the reeds.",
                options: [(text: "How do I fish here?", goto: Some("howto")), (text: "Leave.", goto: None)],
            ),
            (
                id: "howto",
                text: "With a fishing rod in your bag, use bait right here: nightcrawlers for perch, minnows for walleye (Cooking 4). Hold still till something bites.",
                options: [(text: "Got it.", goto: None)],
            ),
        ],
    ),
    (
        id: "mama_jo",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Mama Jo's. Pie's fresh, coffee's hot, and truckers get a refill before they ask.",
                options: [
                    (text: "Kat's doing a zine. Would you sign a menu?", when: [QuestAt("road_trip", 2)], goto: Some("menu")),
                    (text: "I'll see a menu.", effects: [OpenShop("mama_jos")], goto: None),
                    (text: "What's good?", goto: Some("good")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "menu",
                text: "A zine! Sugar, nobody gets my signature till they've had the pie.",
                options: [
                    (text: "I bought a slice. Box it up for Kat?", when: [HasItem("cherry_pie", 1)], effects: [TakeItem("cherry_pie", 1), GiveItem("signed_menu", 1)], goto: Some("menu_done")),
                    (text: "I'll get a slice.", goto: None),
                ],
            ),
            (id: "menu_done", text: "There. \"Drive safe, sugar.\" You tell her the pie goes on the cover, or I'll want my signature back.", options: [(text: "Yes ma'am.", goto: None)]),
            (id: "good", text: "Cherry pie. The chicken-fried steak if you're hungry. Coffee if you're driving, and you're driving.", options: [(text: "Sounds good.", goto: None)]),
        ],
    ),
    (
        id: "wanda",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Diesel Bay. Trucks, mostly. I'll look at your hatchback if you say please.",
                options: [
                    (text: "Here's an alternator for Ray's rig.", when: [QuestAt("long_haul", 1), HasItem("alternator", 1)], effects: [TakeItem("alternator", 1), GiveItem("cb_crate", 1), SetQuestStage("long_haul", 2)], goto: Some("fixed")),
                    (text: "Parts?", effects: [OpenShop("diesel_bay")], goto: None),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "fixed",
                text: "That'll do it. Ray says you're running his radios into the city. Here's the crate. Don't drop it.",
                options: [(text: "Careful as anything.", goto: None)],
            ),
        ],
    ),
    (
        id: "big_ray",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Big Ray. Eighteen wheels, forty tons and a CB handle I can't say in front of Mama Jo.",
                options: [
                    (text: "Need a driver?", when: [QuestNotStarted("long_haul"), QuestDone("road_trip")], goto: Some("offer")),
                    (text: "Need a driver?", when: [QuestNotStarted("long_haul"), Not(QuestDone("road_trip"))], goto: Some("not_yet")),
                    (text: "Rizzo signed for the radios.", when: [QuestAt("long_haul", 3), HasItem("delivery_receipt", 1)], effects: [TakeItem("delivery_receipt", 1), CompleteQuest("long_haul")], goto: Some("done")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "not_yet",
                text: "Not from somebody who hasn't been down this road. Drive Route 9 proper, every stop, then come talk to me.",
                options: [(text: "Fair enough.", goto: None)],
            ),
            (
                id: "offer",
                text: "Kat's zine, huh? Then you know the road. My alternator's shot and I've got a load of radios due at the harbor. Get Wanda a working alternator for my rig, then run half my load into the city. Pays good.",
                options: [(text: "Ten-four.", effects: [StartQuest("long_haul")], goto: None), (text: "Not today.", goto: None)],
            ),
            (
                id: "done",
                text: "Ten-four, good buddy. You drive like you mean it. Here's your cut, and a handset so you can hear the road.",
                options: [(text: "Keep on truckin'.", goto: None)],
            ),
        ],
    ),
    (
        id: "cb_base",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Static, then a voice: \"...breaker one-nine, got a smokey in a plain wrapper at Mile 80, westbound. Keep it under the double nickel...\"",
                options: [(text: "Keep listening.", goto: Some("two")), (text: "Switch it off.", goto: None)],
            ),
            (
                id: "two",
                text: "\"...anybody seen the lights in that Pinecrest bell tower? Ten-four, I seen 'em. Ghosts don't run on batteries, good buddy...\"",
                options: [(text: "Keep listening.", goto: Some("three")), (text: "Switch it off.", goto: None)],
            ),
            (
                id: "three",
                text: "\"...Mama Jo's got cherry pie, and if you're hungry, and you are, the steak. This is Big Ray, eastbound and down...\"",
                options: [(text: "Keep listening.", goto: Some("hello")), (text: "Switch it off.", goto: None)],
            ),
        ],
    ),
    // --- Milestone 16: raids.
    (
        id: "cipher",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Don't look at me. Look at the building. Meridian keeps a vault in the sub-basement, and what's in it is going to make Y2K look like a power cut.",
                options: [
                    (text: "What's in the vault?", goto: Some("vault")),
                    (text: "We're ready to go in. (A party of 3 or more)", when: [SkillLevel(Hacking, 5)], effects: [StartRaid("meridian_vault")], goto: None),
                    (text: "We're ready to go in.", when: [Not(SkillLevel(Hacking, 5))], goto: Some("no_hacker")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "vault",
                text: "The Y2K fund. Meridian's been billing the city for 'compliance work' nobody did. Get down there with a crew, get past security and Chief Brackett, and Zer0 Day will make sure the papers hear about it. Ten minutes before the cops show up.",
                options: [(text: "Got it.", goto: None)],
            ),
            (
                id: "no_hacker",
                text: "With what, a crowbar? Somebody has to get through the service door. Come back when you can hack (Hacking 5).",
                options: [(text: "Fine.", goto: None)],
            ),
        ],
    ),
    // --- Milestone 17: animals.
    (
        id: "tyler",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Mister! There's a MONSTER in the boathouse. It ate all our marshmallows. Billy saw its eyes. They glow.",
                options: [
                    (text: "I'll take a look.", when: [QuestNotStarted("lake_monster")], effects: [StartQuest("lake_monster"), ResetKills("boathouse_raccoon"), ResetKills("big_bandit")], goto: Some("brave")),
                    (text: "Your monster's a raccoon. A big fat one.", when: [QuestAt("lake_monster", 2)], effects: [CompleteQuest("lake_monster")], goto: Some("done")),
                    (text: "Still looking.", when: [Not(QuestNotStarted("lake_monster")), Not(QuestDone("lake_monster")), Not(QuestAt("lake_monster", 2))], goto: Some("hurry")),
                    (text: "Monsters aren't real.", goto: None),
                ],
            ),
            (id: "brave", text: "You're so brave. I'll watch from here. Way over here.", options: [(text: "Stay put.", goto: None)]),
            (id: "hurry", text: "Did you see it? Is it huge? It's huge, isn't it.", options: [(text: "Working on it.", goto: None)]),
            (id: "done", text: "A RACCOON? Billy's gonna be so mad he was scared. Here, these are my dad's minnows. Don't tell him.", options: [(text: "Our secret.", goto: None)]),
        ],
    ),
    // --- Milestone 17: cars.
    (
        id: "fast_eddie",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Fast Eddie's! Every car on this lot was driven by a little old lady, on Sundays, to church. Mostly.",
                options: [(text: "What've you got?", goto: Some("lot")), (text: "Just passing.", goto: None)],
            ),
            (
                id: "lot",
                text: "Family Minivan, $550. Pickup Truck, $650. The Turbo Coupe, $1,200, for drivers who know what they're doing (Driving 5). And the Roadster, $2,000: Driving 10, and don't tell your mother. Cash only, no refunds.",
                options: [
                    (text: "The '97 Family Minivan. ($550)", when: [Cash(550)], effects: [TakeCash(550), GiveCar("minivan")], goto: Some("sold")),
                    (text: "The '94 Pickup Truck. ($650)", when: [Cash(650)], effects: [TakeCash(650), GiveCar("pickup")], goto: Some("sold")),
                    (text: "The '89 Turbo Coupe. ($1,200)", when: [Cash(1200), SkillLevel(Driving, 5)], effects: [TakeCash(1200), GiveCar("coupe")], goto: Some("sold")),
                    (text: "The '99 Roadster. ($2,000)", when: [Cash(2000), SkillLevel(Driving, 10)], effects: [TakeCash(2000), GiveCar("roadster")], goto: Some("sold")),
                    (text: "Just looking.", goto: None),
                ],
            ),
            (
                id: "sold",
                text: "Pleasure doing business! She's parked right next to you. Hank in Pinecrest does paint jobs and parts: tell him Eddie sent you. He'll charge you double.",
                options: [(text: "Thanks, Eddie.", goto: None)],
            ),
        ],
    ),
]
