// Dialogue trees. Options are shown only when all `when` conditions hold, and the server
// re-checks them when chosen. `effects` apply all-or-nothing. `goto: None` ends the conversation.
[
    (
        id: "dot",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to the Byte Cafe! ...Well, it's usually busier than this.",
                options: [
                    (text: "Why is it so quiet in here?", when: [QuestNotStarted("56k_dreams")], goto: Some("problem")),
                    (text: "Still looking for that modem.", when: [QuestAt("56k_dreams", 0)], goto: Some("reminder")),
                    (text: "I'm working on fixing the modem.", when: [QuestAt("56k_dreams", 1)], goto: Some("reminder")),
                    (
                        text: "Here's your modem, good as new!",
                        when: [QuestAt("56k_dreams", 2), HasItem("working_modem", 1)],
                        effects: [TakeItem("working_modem", 1), CompleteQuest("56k_dreams")],
                        goto: Some("reward"),
                    ),
                    (text: "How's business?", when: [QuestDone("56k_dreams")], goto: Some("business")),
                    (text: "Can I use the e-Bid terminal?", when: [QuestDone("56k_dreams")], effects: [OpenMarket], goto: None),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "Our modem got fried in last night's storm. No modem, no internet, no customers. Could you find me a replacement?",
                options: [
                    (text: "I'll find you one.", effects: [StartQuest("56k_dreams")], goto: Some("accepted")),
                    (text: "Sorry, not my problem.", goto: None),
                ],
            ),
            (
                id: "accepted",
                text: "You're a star, {name}! Try Sal at Pawn & Pager, just down the street. He has a bit of everything.",
                options: [(text: "On my way.", goto: None)],
            ),
            (
                id: "reminder",
                text: "Every hour offline, another regular goes to the library instead. Hurry!",
                options: [(text: "I'm on it.", goto: None)],
            ),
            (
                id: "reward",
                text: "*plugs it in* ...Beeee-dong-dong-kshhhh! We're online! Here's for your trouble, and take my old pager. I've upgraded to a cell phone.",
                options: [(text: "Thanks, Dot!", goto: None)],
            ),
            (
                id: "business",
                text: "Booming! Everybody wants to check their email and argue on forums. Oh, and we've got e-Bid now. Ask and you can use the terminal.",
                options: [(text: "Glad to hear it.", goto: None)],
            ),
        ],
    ),
    (
        id: "sal",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Pawn & Pager. If it beeps, buzzes or blinks, I buy it. If it's broken, I sell it cheap.",
                options: [
                    (text: "Dot sent me. Got a 56k modem?", when: [QuestAt("56k_dreams", 0)], goto: Some("modem")),
                    (text: "Show me what you've got.", effects: [OpenShop("pawn_shop")], goto: None),
                    (text: "Any advice?", goto: Some("advice")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "modem",
                text: "Got one. Thing's fried, though. Fifteen bucks and it's yours. Fix it yourself and you save a fortune.",
                options: [
                    (
                        text: "Deal. ($15)",
                        when: [Cash(15)],
                        effects: [TakeCash(15), GiveItem("broken_modem", 1), SetQuestStage("56k_dreams", 1)],
                        goto: Some("sold"),
                    ),
                    (text: "I don't have $15 right now.", when: [Not(Cash(15))], goto: None),
                    (text: "Let me think about it.", goto: None),
                ],
            ),
            (
                id: "sold",
                text: "Pleasure doing business. You'll want a screwdriver set for that. Mr. Kim sells them across the street.",
                options: [(text: "Thanks.", goto: None)],
            ),
            (
                id: "advice",
                text: "I buy broken gear cheap and sell it fixed. Learn Electronics and you can do the fixing, and I'll still buy what you fix.",
                options: [(text: "Good to know.", goto: None)],
            ),
        ],
    ),
    (
        id: "kim",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Corner Store 24/7. We never close, not even for Y2K.",
                options: [
                    (text: "Let me see what you have.", effects: [OpenShop("corner_store")], goto: None),
                    (text: "Anything new?", goto: Some("news")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "news",
                text: "I sold forty cans of Fizz Cola to the arcade kids before lunch. Also, someone keeps burning CDs and leaving them in my mailbox.",
                options: [(text: "Weird.", goto: None)],
            ),
        ],
    ),
    (
        id: "rizzo",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Watch your step, kid. The docks ain't Maple Street.",
                options: [
                    (text: "Anything I can help with?", when: [QuestNotStarted("rat_problem")], goto: Some("problem")),
                    (text: "Still working on those Dock Rats.", when: [QuestAt("rat_problem", 0)], goto: Some("reminder")),
                    (
                        text: "The Dock Rats won't bother your containers anymore.",
                        when: [QuestAt("rat_problem", 1)],
                        effects: [CompleteQuest("rat_problem")],
                        goto: Some("reward"),
                    ),
                    (text: "Got anything for a friend of the docks?", effects: [OpenShop("dockside_locker")], goto: None),
                    (text: "Who's the big guy by the cranes?", goto: Some("sully")),
                    (text: "See you around.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "The Dock Rats keep swiping stuff off my containers. Knock five of 'em down a peg and they'll get the message. You'll want something better than your fists. Sal sells bats.",
                options: [
                    (text: "Consider it done.", effects: [StartQuest("rat_problem"), ResetKills("dock_rat")], goto: None),
                    (text: "Not my fight.", goto: None),
                ],
            ),
            (
                id: "reminder",
                text: "They hang around the containers in the middle of the yard. Five of 'em.",
                options: [(text: "On it.", goto: None)],
            ),
            (
                id: "reward",
                text: "Ha! Quietest it's been all week. Here, for your trouble. And take a couple of these, you look like you need 'em.",
                options: [(text: "Thanks, Rizzo.", goto: None)],
            ),
            (
                id: "sully",
                text: "Big Sully. Runs the Wharf Hounds. Don't go near him unless you've got friends and a first aid kit.",
                options: [(text: "Noted.", goto: Some("hello"))],
            ),
        ],
    ),
    (
        id: "joey",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Pixel Palace! New releases on the left, used carts on the right, no loitering on the demo kiosk.",
                options: [
                    (text: "Let me browse.", effects: [OpenShop("pixel_palace")], goto: None),
                    (text: "You look busy.", when: [QuestNotStarted("mall_rats")], goto: Some("problem")),
                    (text: "Still collecting CDs for you.", when: [QuestAt("mall_rats", 0)], goto: Some("reminder")),
                    (
                        text: "Here are three burned CDs.",
                        when: [QuestAt("mall_rats", 1), HasItem("burned_cd", 3)],
                        effects: [TakeItem("burned_cd", 3), CompleteQuest("mall_rats")],
                        goto: Some("reward"),
                    ),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "I'm making the ultimate mall mixtape. I need source material: burned CDs, any kind. Bring me three? Mr. Kim downtown sells them, or the Dock Rats always seem to have some.",
                options: [
                    (text: "Three burned CDs, coming up.", effects: [StartQuest("mall_rats")], goto: None),
                    (text: "Not really my thing.", goto: None),
                ],
            ),
            (id: "reminder", text: "Three burned CDs. Any kind. Even the Celine Dion ones.", options: [(text: "On it.", goto: None)]),
            (
                id: "reward",
                text: "Sweet! Here, the first copy is yours. Don't tape over it.",
                options: [(text: "Thanks, Joey.", goto: None)],
            ),
        ],
    ),
    (
        id: "wendy",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Gadget Shack, how can I help you? We pay better than the pawn shop for working gear. Don't tell Sal.",
                options: [
                    (text: "Show me what you've got.", effects: [OpenShop("gadget_shack")], goto: None),
                    (text: "Can I use your e-Bid terminal?", effects: [OpenMarket], goto: None),
                    (text: "What sells best?", goto: Some("tips")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "tips",
                text: "Camcorders. Everyone wants to be a director. We get busted ones in all the time. Fix one up and I'll pay you well for it, if you know what you're doing with a screwdriver.",
                options: [(text: "Good to know.", goto: None)],
            ),
        ],
    ),
    (
        id: "gary",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "No running, no skating, no fighting. This is a family mall.",
                options: [
                    (text: "What's at the factory?", goto: Some("factory")),
                    (text: "Yes, officer.", goto: None),
                ],
            ),
            (
                id: "factory",
                text: "The old Kessler plant? Scrappers stripping copper out of it. Old Earl still runs a salvage stall by the gate. Take the Metro east.",
                options: [(text: "Thanks.", goto: None)],
            ),
        ],
    ),
    (
        id: "earl",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Careful in there. Those Scrappers would strip the fillings out of your teeth.",
                options: [
                    (text: "Need a hand?", when: [QuestNotStarted("scrap_run")], goto: Some("problem")),
                    (text: "Still gathering scrap.", when: [QuestAt("scrap_run", 0)], goto: Some("reminder")),
                    (
                        text: "Here's your scrap metal.",
                        when: [QuestAt("scrap_run", 1), HasItem("scrap_metal", 6)],
                        effects: [TakeItem("scrap_metal", 6), CompleteQuest("scrap_run")],
                        goto: Some("reward"),
                    ),
                    (text: "How's the car coming along?", when: [QuestDone("scrap_run"), QuestNotStarted("junker")], goto: Some("junker_offer")),
                    (text: "About the hatchback...", when: [QuestAt("junker", 0)], goto: Some("junker_reminder")),
                    (
                        text: "I've got everything for the hatchback.",
                        when: [QuestAt("junker", 1), HasItem("carburetor", 1), HasItem("car_battery", 1), HasItem("spark_plug", 2)],
                        effects: [
                            TakeItem("carburetor", 1),
                            TakeItem("car_battery", 1),
                            TakeItem("spark_plug", 2),
                            CompleteQuest("junker"),
                            GiveCar("hatchback"),
                        ],
                        goto: Some("junker_done"),
                    ),
                    (text: "Let's trade.", effects: [OpenShop("earl_salvage")], goto: None),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "problem",
                text: "I'm rebuilding an old car, but I'm short on scrap metal. Six pieces should do. The Scrappers and Copper Thieves in there carry plenty.",
                options: [
                    (text: "I'll get you six.", effects: [StartQuest("scrap_run")], goto: None),
                    (text: "Maybe later.", goto: None),
                ],
            ),
            (id: "reminder", text: "Six pieces of scrap. The Scrappers hang around the heaps.", options: [(text: "Right.", goto: None)]),
            (
                id: "reward",
                text: "That's the stuff. Take my spare wrench, and watch how I do this. You've got the hands for it.",
                options: [(text: "Thanks, Earl.", goto: None)],
            ),
            (
                id: "junker_offer",
                text: "Body's done, but she still won't start. Tell you what: get her running and she's yours. I need a carburetor, a battery and two spark plugs. The Scrappers carry rusty carbs; rebuild one with that wrench. And you'll want to know what you're doing: Mechanics 3, at least.",
                options: [
                    (text: "Deal.", effects: [StartQuest("junker")], goto: None),
                    (text: "Maybe later.", goto: None),
                ],
            ),
            (
                id: "junker_reminder",
                text: "A carburetor, a car battery, two spark plugs, and Mechanics 3. I sell rusty carbs and plugs if the Scrappers won't give you any.",
                options: [(text: "On it.", goto: None)],
            ),
            (
                id: "junker_done",
                text: "Listen to that engine! She's all yours, kid. Highway's at the south end of the yard, takes you right onto Maple Street. Go see Dash downtown if you want to race.",
                options: [(text: "Thanks, Earl!", goto: None)],
            ),
        ],
    ),
    (
        id: "dash",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "You here to race, or just to look at the paint jobs?",
                options: [
                    (text: "Let's race.", effects: [StartRace("maple_loop")], goto: None),
                    (text: "How does it work?", goto: Some("rules")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "rules",
                text: "Maple & 5th Sprint. East end of Maple, south end of 5th, north end of 5th, then back here. Fifty seconds. Make it and I'll pay you thirty bucks. Pull up next to me in your car and say the word.",
                options: [(text: "Got it.", goto: None)],
            ),
        ],
    ),
    (
        id: "crystal",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Threads! Everything's 30% off, which means it was overpriced by 30%. Looking for something?",
                options: [
                    (text: "Show me the clothes.", effects: [OpenShop("threads")], goto: None),
                    (text: "Do clothes actually help?", goto: Some("tips")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "tips",
                text: "Duh. A good jacket takes a punch, the right shoes and you're faster on your feet, shades and a cap and you drive like you mean it. Open your inventory and use something to put it on.",
                options: [(text: "Good to know.", goto: None)],
            ),
        ],
    ),
    (
        id: "pemberton",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Pemberton, Meridian Corp, Facilities. Make it quick, we have four hundred days to make every computer in this building understand the year 2000.",
                options: [
                    (text: "Need help with that?", when: [QuestNotStarted("y2k_compliance")], goto: Some("offer")),
                    (text: "About those modems...", when: [QuestAt("y2k_compliance", 0)], goto: Some("reminder")),
                    (
                        text: "Two working modems, as ordered.",
                        when: [QuestAt("y2k_compliance", 1), HasItem("working_modem", 2)],
                        effects: [TakeItem("working_modem", 2), CompleteQuest("y2k_compliance")],
                        goto: Some("reward"),
                    ),
                    (text: "What does Meridian sell?", effects: [OpenShop("meridian_supply")], goto: None),
                    (text: "What does Meridian think of me?", goto: Some("standing")),
                    (text: "Never mind.", goto: None),
                ],
            ),
            (
                id: "offer",
                text: "Our modems are older than our interns. Bring me two working ones and Meridian will remember your name. Fondly, even. The pawn shop has broken ones; I'm told a screwdriver fixes most things.",
                options: [
                    (text: "Two modems, coming up.", effects: [StartQuest("y2k_compliance")], goto: None),
                    (text: "Not my department.", goto: None),
                ],
            ),
            (id: "reminder", text: "Two. Working. Modems. The clock is ticking, literally.", options: [(text: "On it.", goto: None)]),
            (
                id: "reward",
                text: "Excellent. You're a credit to the private sector. Our supply store will treat you like family now. Well, like a cousin.",
                options: [(text: "Pleasure doing business.", goto: None)],
            ),
            (
                id: "standing",
                text: "Meridian rewards loyalty. Help us and our store gives you better prices, and the good stuff: suits, PalmPilots. Check your standing in your skills window.",
                options: [(text: "Noted.", goto: None)],
            ),
        ],
    ),
    (
        id: "flo",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Sit anywhere, hon. Unless you can cook. Can you cook? My fry cook ran off to be in a band.",
                options: [
                    (text: "I can cook.", when: [QuestNotStarted("lunch_rush")], goto: Some("offer")),
                    (text: "Still on those sandwiches.", when: [QuestAt("lunch_rush", 0)], goto: Some("reminder")),
                    (
                        text: "Three grilled cheese, order up!",
                        when: [QuestAt("lunch_rush", 1), HasItem("grilled_cheese", 3)],
                        effects: [TakeItem("grilled_cheese", 3), CompleteQuest("lunch_rush")],
                        goto: Some("reward"),
                    ),
                    (text: "What's on the menu?", effects: [OpenShop("sunny_side")], goto: None),
                    (text: "Just looking.", goto: None),
                ],
            ),
            (
                id: "offer",
                text: "Prove it. Three grilled cheese for the lunch rush. Doug at the grocery has bread and cheese, and he'll sell you a pan. Use the cheese to start cooking.",
                options: [
                    (text: "Coming right up.", effects: [StartQuest("lunch_rush")], goto: None),
                    (text: "On second thought...", goto: None),
                ],
            ),
            (id: "reminder", text: "Three grilled cheese, golden brown. The truckers are getting restless.", options: [(text: "Working on it.", goto: None)]),
            (
                id: "reward",
                text: "Now THAT is a sandwich. Here, take the hat, it's yours. And if you ever cook more than you can eat, I'll buy it off you.",
                options: [(text: "Thanks, Flo.", goto: None)],
            ),
        ],
    ),
    (
        id: "doug",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Welcome to Value Grocer, where the value is... somewhere. Aisle six, probably.",
                options: [
                    (text: "Let me see what you've got.", effects: [OpenShop("value_grocer")], goto: None),
                    (text: "Any cooking tips?", goto: Some("tips")),
                    (text: "Bye.", goto: None),
                ],
            ),
            (
                id: "tips",
                text: "Grilled cheese and eggs, anybody can do. Coffee you've gotta know your beans, Cooking 2. Burgers, Cooking 3. And watch out for the pranksters out back, they've been egging the houses.",
                options: [(text: "Thanks, Doug.", goto: None)],
            ),
        ],
    ),
    (
        id: "payphone",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A scratched payphone. Quarters only. The coin box hasn't been emptied in a while, and the handset cord looks easy to tap.",
                options: [
                    (text: "Hack it.", effects: [Hack("payphone")], goto: None),
                    (text: "Make a call.", goto: Some("call")),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
            (id: "call", text: "You get a busy signal, then a modem squeal, then someone saying \"wrong number, narc\". Click.", options: [(text: "Hang up.", goto: None)]),
        ],
    ),
    (
        id: "atm",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A Meridian Corp ATM. The screen says WELCOME in a font from 1987. There is a maintenance port under the keypad.",
                options: [
                    (text: "Hack it.", effects: [Hack("meridian_atm")], goto: None),
                    (text: "Check my balance.", goto: Some("balance")),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
            (id: "balance", text: "INSUFFICIENT FUNDS. HAVE A MERIDIAN DAY.", options: [(text: "Rude.", goto: None)]),
        ],
    ),
    (
        id: "arcade",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Street Kombat II. The high-score table is full of initials you don't know. The coin door is held shut with tape.",
                options: [
                    (text: "Hack it.", effects: [Hack("arcade_highscore")], goto: None),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "factory_panel",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A rusty keypad by the Main Hall doors. A sticker says SECURITY BY KRANKCO. The wires run somewhere warm.",
                options: [
                    (text: "Hack it.", effects: [Hack("factory_panel")], goto: None),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "harbor_terminal",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "A beige terminal behind the Harbor Office window, still logged in to SHIPPING-MGR. Green text blinks patiently.",
                options: [
                    (text: "Hack it.", effects: [Hack("harbor_office")], goto: None),
                    (text: "Leave it alone.", goto: None),
                ],
            ),
        ],
    ),
    (
        id: "glitch",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "...You're blocking my signal. What do you want?",
                options: [
                    (text: "I heard you're a hacker.", when: [QuestNotStarted("phreaking_101")], goto: Some("intro")),
                    (text: "Still working on that payphone.", when: [QuestAt("phreaking_101", 0)], goto: Some("phone_reminder")),
                    (text: "The payphone's mine.", when: [QuestAt("phreaking_101", 1)], effects: [CompleteQuest("phreaking_101")], goto: Some("welcome")),
                    (
                        text: "Got a real job for me?",
                        when: [QuestDone("phreaking_101"), QuestNotStarted("black_ice"), Rep("zeros", 100)],
                        goto: Some("black_ice"),
                    ),
                    (text: "About the Harbor Office...", when: [QuestAt("black_ice", 0)], goto: Some("ice_reminder")),
                    (text: "Here are your manifests.", when: [QuestAt("black_ice", 1)], effects: [CompleteQuest("black_ice")], goto: Some("ice_done")),
                    (text: "What've you got?", when: [QuestDone("phreaking_101")], effects: [OpenShop("zeros_stash")], goto: None),
                    (text: "How does hacking work?", goto: Some("howto")),
                    (text: "Never mind.", goto: None),
                ],
            ),
            (
                id: "intro",
                text: "Hacker is a strong word. I \"explore systems\". Want in? Prove it. The payphone on the corner of Maple & 5th. Make it yours.",
                options: [
                    (text: "Easy.", effects: [StartQuest("phreaking_101")], goto: None),
                    (text: "Sounds illegal.", goto: None),
                ],
            ),
            (id: "phone_reminder", text: "The payphone. Corner of Maple & 5th. It's not going to hack itself.", options: [(text: "Right.", goto: None)]),
            (
                id: "welcome",
                text: "Not bad for a newbie. Take this coupler, it'll make you faster. Welcome to Zer0 Day. We never met.",
                options: [(text: "Never met who?", goto: None)],
            ),
            (
                id: "black_ice",
                text: "The Dockside Crew is moving something through the harbor and Meridian is paying them to. The manifests are on the Harbor Office terminal. That system's no payphone: Hacking 6, and you'll want gear.",
                options: [
                    (text: "I'm in.", effects: [StartQuest("black_ice")], goto: None),
                    (text: "Not yet.", goto: None),
                ],
            ),
            (id: "ice_reminder", text: "Harbor Office terminal, docks. Hacking 6. Don't trip the alarm.", options: [(text: "Got it.", goto: None)]),
            (
                id: "ice_done",
                text: "Meridian AND the Dockside Crew. I knew it. Here, you've earned a real machine. Don't tell anyone where you got it.",
                options: [(text: "Where did I get what?", goto: None)],
            ),
            (
                id: "howto",
                text: "Talk to a system and choose Hack. You get a code for a second, memorize it, type it in before the timer runs out. Higher Hacking, easier codes. Gear helps. Mess up and the alarm goes, and City Services don't like that.",
                options: [(text: "Cool.", goto: None)],
            ),
        ],
    ),
    (
        id: "vinnie",
        start: "hello",
        nodes: [
            (
                id: "hello",
                text: "Dogs! Hot dogs! Best thing open after eight, guaranteed, because nothing else is open after eight.",
                options: [
                    (text: "One dog, everything on it.", effects: [OpenShop("late_night_dogs")], goto: None),
                    (text: "Quiet night?", goto: Some("night")),
                    (text: "Later, Vinnie.", goto: None),
                ],
            ),
            (
                id: "night",
                text: "Quiet? The taggers come out after dark. Spray cans everywhere. City Services pays good attention to anybody who runs 'em off, if you catch my drift.",
                options: [(text: "Caught.", goto: None)],
            ),
        ],
    ),
]
