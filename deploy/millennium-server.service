# systemd unit for a Millennium dedicated server. See docs/deploy.md.
#
#   sudo cp deploy/millennium-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now millennium-server
#   journalctl -u millennium-server -f

[Unit]
Description=Millennium game server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=millennium
Group=millennium
# Relative paths in the config (saves/tls, saves/backups, a sqlite:// file) live here.
WorkingDirectory=/var/lib/millennium
ExecStart=/usr/local/bin/millennium-server --config /etc/millennium/server.toml
# Secrets: DATABASE_URL=..., MILLENNIUM_PRIVATE_KEY=... (chmod 600, owned by root).
EnvironmentFile=-/etc/millennium/env
# Ctrl-C-style shutdown: everyone online is saved before it exits.
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Hardening: the server only needs its working directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/millennium

[Install]
WantedBy=multi-user.target
